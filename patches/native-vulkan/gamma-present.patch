+bool ComponentMappingsEqual(const VkComponentMapping& left, const VkComponentMapping& right) {
+  return left.r == right.r && left.g == right.g && left.b == right.b && left.a == right.a;
+}
+
+uint8_t GetSwizzled8bpcComponent(const uint8_t* pixel, VkFormat format,
+                                 VkComponentSwizzle swizzle, size_t output_component) {
+  if (swizzle == VK_COMPONENT_SWIZZLE_IDENTITY) {
+    static constexpr VkComponentSwizzle kOutputSwizzles[] = {
+        VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_B,
+        VK_COMPONENT_SWIZZLE_A};
+    swizzle = kOutputSwizzles[output_component];
+  }
+  switch (swizzle) {
+    case VK_COMPONENT_SWIZZLE_ZERO:
+      return 0;
+    case VK_COMPONENT_SWIZZLE_ONE:
+      return 255;
+    case VK_COMPONENT_SWIZZLE_R:
+      return pixel[format == VK_FORMAT_B8G8R8A8_UNORM ? 2 : 0];
+    case VK_COMPONENT_SWIZZLE_G:
+      return pixel[1];
+    case VK_COMPONENT_SWIZZLE_B:
+      return pixel[format == VK_FORMAT_B8G8R8A8_UNORM ? 0 : 2];
+    case VK_COMPONENT_SWIZZLE_A:
+      return pixel[3];
+    default:
+      return 0;
+  }
+}
+
