+// SPDX-License-Identifier: BSD-3-Clause
+// Gamma-table packing and dither noise follow the Xenia/ReXGlue shaders.
+#version 450
+
+layout(set = 0, binding = 0) uniform texture2D gamma_source;
+layout(set = 0, binding = 1) uniform sampler gamma_source_sampler;
+layout(set = 0, binding = 2, std430) readonly buffer GammaRamp {
+  uint gamma[256];
+} gamma_ramp;
+
+layout(push_constant, std430) uniform GammaBilinearConstants {
+  layout(offset = 16) ivec2 output_offset;
+  layout(offset = 24) vec2 output_size_inv;
+}
+gamma_bilinear;
+
+layout(location = 0) out vec4 out_color;
+
+const float kUnorm10Max = 1023.0;
+
+// A gamma-table entry is the packed Xenos DC_LUT_30_COLOR word:
+// B occupies bits 0-9, G bits 10-19, and R bits 20-29. Returning the
+// extracted integer codes divided by 1023 exactly models the old
+// A2B10G10R10_UNORM storage write and sample for each tap.
+vec3 GammaAtPixel(ivec2 pixel, ivec2 source_size) {
+  ivec2 clamped_pixel = clamp(pixel, ivec2(0), source_size - ivec2(1));
+  vec3 input_rgb = texelFetch(sampler2D(gamma_source, gamma_source_sampler), clamped_pixel, 0).rgb;
+
+  // Match apply_gamma_table_cs: truncation of value * 255 + 0.5 gives the
+  // nearest 8-bit table index for the normalized UNORM source.
+  uvec3 index = uvec3(input_rgb * 255.0 + vec3(0.5));
+  uint red_word = gamma_ramp.gamma[index.r];
+  uint green_word = gamma_ramp.gamma[index.g];
+  uint blue_word = gamma_ramp.gamma[index.b];
+  uvec3 code = uvec3((red_word >> 20) & 1023u, (green_word >> 10) & 1023u,
+                     blue_word & 1023u);
+  return vec3(code) / kUnorm10Max;
+}
