+bool VulkanPresenter::RefreshGuestOutputWithGammaTable(
+    uint32_t frontbuffer_width, uint32_t frontbuffer_height, uint32_t display_aspect_ratio_x,
+    uint32_t display_aspect_ratio_y, VkFormat source_format, VkComponentMapping components,
+    std::function<bool(VulkanGuestOutputRefreshContext& context)> refresher) {
+#if defined(REX_HAS_FIDELITYFX_SDK)
+  // Gamma must precede scaling and sharpening. Keep this API disabled for
+  // FidelityFX builds until the gamma operation is integrated into those flows.
+  (void)frontbuffer_width;
+  (void)frontbuffer_height;
+  (void)display_aspect_ratio_x;
+  (void)display_aspect_ratio_y;
+  (void)source_format;
+  (void)components;
+  (void)refresher;
+  return false;
+#else
+  if (!refresher || (source_format != VK_FORMAT_R8G8B8A8_UNORM &&
+                     source_format != VK_FORMAT_B8G8R8A8_UNORM)) {
+    return false;
+  }
+  if (gamma_table_fallback_buffer_ == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  // Presenter documents that guest output refresh has a single producer and
+  // that callbacks complete synchronously, so this request remains valid for
+  // the whole base RefreshGuestOutput call, including its optional immediate
+  // paint.
+  gamma_table_refresh_request_ = GammaTableRefreshRequest{source_format, components};
+  struct RequestReset {
+    std::optional<GammaTableRefreshRequest>& request;
+    ~RequestReset() { request.reset(); }
+  } request_reset{gamma_table_refresh_request_};
+
+  return RefreshGuestOutput(
+      frontbuffer_width, frontbuffer_height, display_aspect_ratio_x, display_aspect_ratio_y,
+      [refresher = std::move(refresher)](GuestOutputRefreshContext& context) mutable {
+        return refresher(static_cast<VulkanGuestOutputRefreshContext&>(context));
+      });
+#endif
+}
+
+bool VulkanPresenter::EnsureGammaTableFallbackBuffer() {
+  if (gamma_table_fallback_buffer_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (util::CreateDedicatedAllocationBuffer(
+          vulkan_device_, 256 * sizeof(uint32_t), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+          util::MemoryPurpose::kDeviceLocal, gamma_table_fallback_buffer_,
+          gamma_table_fallback_memory_)) {
+    return true;
+  }
+
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, gamma_table_fallback_buffer_);
+  if (gamma_table_fallback_memory_ != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, gamma_table_fallback_memory_, nullptr);
+    gamma_table_fallback_memory_ = VK_NULL_HANDLE;
+  }
+  return false;
+}
