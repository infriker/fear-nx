+      0.000911458337, 0.001953125, -0.00140165444, -0.00063572306, 0.00150888483, -0.000819546578, 0.00124846818, 0.000252757367,
+      0.00152420346, 0.00112591917, 0.000359987753, -0.000390625006, 0.00190716912, 0.00138633582, -0.00111060054, 0.00161611522,
+      -0.000880821084, 0.000145526967, 0.00107996329, -5.36151965e-05, 0.00028339462, -0.00169270835, -0.00126378681, -0.000513174047,
+      -0.000160845593, -0.00187653187, -0.000834865205, 0.00063572306, 7.65931418e-06, -0.00190716912, -0.000222120099, 0.000375306379,
+      -0.00173866423, -0.000405943632, -0.00123314955, 0.00170802698, -0.00094209559, 0.000819546578, 0.00184589461, 0.000467218139);
+float GammaDitherValue(uint x, uint y) {
+  return kGammaDitherNoise[(y & 15u) * 16u + (x & 15u)];
+}
+#endif
+
+void main() {
+  ivec2 source_size = textureSize(sampler2D(gamma_source, gamma_source_sampler), 0);
+  ivec2 output_pixel = ivec2(gl_FragCoord.xy);
+  ivec2 local_pixel = output_pixel - gamma_bilinear.output_offset;
+
+  // An exact 1:1 mapping samples a texel center, so avoid four source taps and
+  // twelve LUT reads when no resampling is needed.
+  ivec2 output_size =
+      ivec2(round(vec2(1.0) / gamma_bilinear.output_size_inv));
+  vec3 rgb;
+  if (all(equal(output_size, source_size))) {
+    rgb = GammaAtPixel(local_pixel, source_size);
+  } else {
+    vec2 uv = (vec2(local_pixel) + vec2(0.5)) * gamma_bilinear.output_size_inv;
+    vec2 source_position = uv * vec2(source_size) - vec2(0.5);
+    ivec2 base = ivec2(floor(source_position));
+    vec2 weight = fract(source_position);
+
+    vec3 top_left = GammaAtPixel(base, source_size);
+    vec3 top_right = GammaAtPixel(base + ivec2(1, 0), source_size);
+    vec3 bottom_left = GammaAtPixel(base + ivec2(0, 1), source_size);
+    vec3 bottom_right = GammaAtPixel(base + ivec2(1, 1), source_size);
+    rgb = mix(mix(top_left, top_right, weight.x),
+              mix(bottom_left, bottom_right, weight.x), weight.y);
+  }
+
+#ifdef GAMMA_DITHER
+  rgb = clamp(rgb + vec3(GammaDitherValue(uint(local_pixel.x), uint(local_pixel.y))),
+              vec3(0.0), vec3(1.0));
+#endif
+
+  out_color = vec4(rgb, 1.0);
+}
