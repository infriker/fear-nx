+static inline void CPU_CLR(int cpu, cpu_set_t* s) {
+    if (cpu >= 0 && cpu < CPU_SETSIZE) s->bits &= ~((uint64_t)1 << cpu);
+}
+static inline int CPU_ISSET(int cpu, const cpu_set_t* s) {
+    return (cpu >= 0 && cpu < CPU_SETSIZE) && ((s->bits >> cpu) & 1);
