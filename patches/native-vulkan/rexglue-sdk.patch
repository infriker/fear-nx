+  s.frames = 0;
+  s.native_draws = 0;
+  s.fallback_draws = 0;
+  s.native_seq_evictions = 0;
+  s.make_range_valid_calls = 0;
+  s.watch_rearms = 0;
+  s.request_range_vertex_bytes = 0;
+  s.request_range_texture_bytes = 0;
+  s.unique_vertex_bytes_sum = 0;
+  s.index_bytes = 0;
+  s.shared_page_overlaps = 0;
+  s.drain_us_sum = 0;
+  s.drain_us_max = 0;
+  s.drain_samples = 0;
