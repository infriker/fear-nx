+        "    stp  q28, q29, [x2], #32\n"
+        "    stp  q30, q31, [x2], #32\n"
+        "    ldr  w3, [x1], #4\n"
+        "    str  w3, [x2], #4\n"
+        "    ldr  w3, [x1], #4\n"
