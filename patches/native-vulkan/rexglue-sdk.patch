+      storage_capable_ = false;
+      return VK_NULL_HANDLE;
+    }
+  }
+  VkDescriptorSetAllocateInfo allocate_info = {};
+  allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  allocate_info.descriptorPool = vulkan_texture_cache.resolve_forward_storage_pool_;
+  allocate_info.descriptorSetCount = 1;
+  allocate_info.pSetLayouts = &vulkan_texture_cache.resolve_forward_storage_set_layout_;
+  if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &storage_descriptor_set_) !=
+      VK_SUCCESS) {
