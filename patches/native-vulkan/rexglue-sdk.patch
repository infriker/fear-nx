+  // defined by its texture format alone, and the shadow maps' depth resolves
+  // carry a nonzero one.
+  const char* dest_reject = nullptr;
+  if (dest_info.copy_dest_exp_bias != 0) {
+    dest_reject = "exponent bias";
+  } else if (dest_info.copy_dest_array) {
+    dest_reject = "array destination";
+  } else if (!is_depth && uint32_t(dest_info.copy_dest_number) != 0) {
+    dest_reject = "color number format";
+  } else if (uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian::k16in32)) {
+    dest_reject = "endianness";
+  } else if (dest_coordinates.offset_x_div_8 || dest_coordinates.offset_y_div_8) {
+    dest_reject = "destination offset";
+  } else if (edram.msaa_samples >= xenos::MsaaSamples::k4X) {
+    dest_reject = "4x MSAA";
+  }
