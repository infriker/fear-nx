+bool VulkanSharedMemory::UploadRangeUnwatchedImpl(uint32_t guest_offset, uint32_t size,
+                                                  const void* host_src,
+                                                  bool to_submission_start) {
+  // Same ordering discipline as UploadRanges - make the buffer a transfer
+  // destination for the range about to be written and flush the barrier before
+  // recording the copy, so it lands ahead of any draw recorded after this
+  // point. Unlike UploadRanges the range is in bytes rather than in pages, and
+  // nothing is marked valid on the way through.
+  // Hoisted copies go to the submission's upload prologue, which has its own
+  // barriers around it (VulkanCommandProcessor::EndSubmission): no barrier
+  // here, and the render pass stays open.
+  if (!unwatched_upload_batch_ && !to_submission_start) {
+    Use(Usage::kTransferDestination, std::make_pair(guest_offset, size));
+    command_processor_.SubmitBarriers(true);
+  }
+  DeferredCommandBuffer& command_buffer = to_submission_start
+                                              ? command_processor_.upload_prologue()
+                                              : command_processor_.deferred_command_buffer();
+  uint64_t submission_current = command_processor_.GetCurrentSubmission();
+
+  const uint8_t* source = reinterpret_cast<const uint8_t*>(host_src);
+  uint32_t upload_range_start = guest_offset;
+  uint32_t upload_range_length = size;
+  bool successful = true;
+  upload_regions_.clear();
+  VkBuffer upload_buffer_previous = VK_NULL_HANDLE;
+  while (upload_range_length) {
+    VkBuffer upload_buffer;
+    VkDeviceSize upload_buffer_offset, upload_buffer_size;
+    uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+        submission_current, upload_range_length, kUnwatchedUploadAlignment, upload_buffer,
+        upload_buffer_offset, upload_buffer_size);
+    if (upload_buffer_mapping == nullptr) {
+      REXGPU_ERROR("Shared memory: Failed to get a Vulkan upload buffer for an unwatched range");
+      successful = false;
+      break;
+    }
+    // RequestPartial rounds the request up to the alignment, so it can hand
+    // back more space than there is left to copy - the source is a plain host
+    // pointer here, with nothing readable past its end.
+    uint32_t upload_size =
+        uint32_t(std::min(VkDeviceSize(upload_range_length), upload_buffer_size));
+    std::memcpy(upload_buffer_mapping, source, upload_size);
+    if (upload_buffer_previous != upload_buffer && !upload_regions_.empty()) {
+      assert_true(upload_buffer_previous != VK_NULL_HANDLE);
+      command_buffer.CmdVkCopyBuffer(upload_buffer_previous, buffer_,
+                                     uint32_t(upload_regions_.size()), upload_regions_.data());
+      upload_regions_.clear();
+    }
+    upload_buffer_previous = upload_buffer;
+    VkBufferCopy& upload_region = upload_regions_.emplace_back();
+    upload_region.srcOffset = upload_buffer_offset;
+    upload_region.dstOffset = VkDeviceSize(upload_range_start);
+    upload_region.size = upload_size;
+    source += upload_size;
+    upload_range_start += upload_size;
+    upload_range_length -= upload_size;
+  }
+  if (!upload_regions_.empty()) {
+    assert_true(upload_buffer_previous != VK_NULL_HANDLE);
+    command_buffer.CmdVkCopyBuffer(upload_buffer_previous, buffer_,
+                                   uint32_t(upload_regions_.size()), upload_regions_.data());
+    upload_regions_.clear();
+  }
+  return successful;
+}
+
+void VulkanSharedMemory::BeginUnwatchedUploadBatch() {
+  // The whole buffer is declared written, so the barrier the next reader
+  // inserts in Use covers every copy of the batch. A barrier per copy drained
+  // the GPU about a thousand times a frame in Free Skate.
+  Use(Usage::kTransferDestination, std::make_pair(uint32_t(0), kBufferSize));
+  command_processor_.SubmitBarriers(true);
+  unwatched_upload_batch_ = true;
+}
