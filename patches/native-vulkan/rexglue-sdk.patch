+        /* Top of this slot's stack: base + (ranura + 1) * 64 KB. */
+        "    adrp x4, g_rex_exc_pilas\n"
+        "    add  x4, x4, :lo12:g_rex_exc_pilas\n"
+        "    add  x7, x7, #1\n"
