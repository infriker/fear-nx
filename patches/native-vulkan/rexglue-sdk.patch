+    // drops the valid bit of every CPU-uploaded page at the end of each frame
+    // without firing watches; skipping those pages meant nothing was hashed
+    // after the first frame, and a texture whose memory the CPU rewrote (video
+    // frames, streamed images) never learned it was outdated. page_hash_ still
+    // holds the contents last uploaded, which is what the texture was built
+    // from.
+    if (page_stable_[page] == kPageHashBaselinePending) {
+      const bool cpu_wrote = SampledPageHash(page) != page_hash_[page];
+      page_hash_[page] =
+          XXH3_64bits(memory().TranslatePhysical(page << page_size_log2_), page_bytes);
+      page_stable_[page] = 0;
+      page_checked_epoch_[page] = frame_epoch_;
+      if (cpu_wrote) {
+        hash_changed_pages_.push_back(page);
+      }
+      ++pages_checked;
+      ++page;
+      continue;
+    }
+    const uint32_t interval =
+        hash_backoff_ ? uint32_t(1) << std::min<uint32_t>(page_stable_[page], 5) : 1;
+    if (frame_epoch_ - page_checked_epoch_[page] < interval) {
+      ++pages_deferred;
+      ++page;
+      continue;
+    }
+    ++pages_checked;
+    page_checked_epoch_[page] = frame_epoch_;
+    // A page unchanged through every check up to the longest interval is
+    // checked by two small samples instead, with a full hash on one check in
+    // eight: textures are rewritten whole when they change, and the full hash
+    // of every bound texture's pages was an eighth of this thread in busy
+    // scenes.
+    if (page_stable_[page] >= 5 && ((page + (frame_epoch_ >> 5)) & 7) != 0 &&
+        SampledPageHash(page) == page_sample_hash_[page]) {
