+uint64_t SharedMemory::SampledPageHash(uint32_t page) const {
+  const uint8_t* bytes =
+      reinterpret_cast<const uint8_t*>(memory().TranslatePhysical(page << page_size_log2_));
+  const uint32_t half = uint32_t(1) << (page_size_log2_ - 1);
+  return XXH3_64bits(bytes, 64) ^ (XXH3_64bits(bytes + half, 64) * UINT64_C(0x9E3779B97F4A7C15));
+}
+
+void SharedMemory::HashValidateRange(uint32_t start, uint32_t length) {
+  if (!hash_validation_ || !length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  const uint32_t page_first = start >> page_size_log2_;
+  const uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  const uint32_t page_bytes = uint32_t(1) << page_size_log2_;
+  HashValidatedRange& validated = hash_validated_ranges_[start];
+  if (validated.epoch == frame_epoch_ && validated.length >= length) {
+    // Every page in it was checked this frame, or skipped by the backoff,
+    // exactly as walking it again would find.
+#if REX_PLATFORM_SWITCH
+    RexSwitchPerfAdd(58, page_last - page_first + 1);
+#endif
+    return;
+  }
+  if (validated.epoch != frame_epoch_) {
+    validated.epoch = frame_epoch_;
+    validated.length = 0;
+  }
+  validated.length = std::max(validated.length, length);
+  uint32_t pages_deferred = 0, pages_checked = 0;
+  hash_changed_pages_.clear();
+  // Hashed without the global lock: reading guest memory needs none, and the
+  // guest threads contend for it. A write racing the read is caught next check.
+  for (uint32_t page = page_first; page <= page_last;) {
+    // A whole 64-page block inside the range that was already walked this
+    // frame would give the same answer page by page: every page in it was
+    // checked or deferred for this frame. The same large vertex buffers are
+    // requested from many different starts per frame, which the per-range
+    // memo above does not catch, and walking them again page by page was
+    // most of this function's cost.
+    if (!(page & 63) && page_last - page >= 63) {
+      uint32_t& block_epoch = block_checked_epoch_[page >> 6];
+      if (block_epoch == frame_epoch_) {
+        pages_deferred += 64;
+        page += 64;
+        continue;
+      }
+      block_epoch = frame_epoch_;
+    }
