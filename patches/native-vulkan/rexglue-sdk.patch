+struct RecordPrefix {
+  uint16_t type;
+  uint16_t size_bytes;
+  uint32_t ordinal;
+};
+
+struct HeaderRecord {
+  RecordPrefix prefix;
+  char magic[8];
+  uint32_t schema_version;
