+  const VkDescriptorSetLayout storage_set_layout =
+      is_depth ? VK_NULL_HANDLE : texture_cache.resolve_forward_storage_set_layout();
+  const VkPipeline image_pipeline =
+      storage_set_layout != VK_NULL_HANDLE
