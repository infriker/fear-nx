+bool VulkanRenderTargetCache::TryForwardResolve(const draw_util::ResolveInfo& resolve_info,
+                                                VulkanTextureCache& texture_cache) {
+  // Every resolve used to become three GPU passes: dump the render target into
+  // the EDRAM buffer, convert that into the tiled guest layout in shared
+  // memory, then untile it again when the texture reading it is reloaded. In
+  // Free Skate each destination is read by exactly one texture of the same
+  // format, so when the conversion is a plain 8888 copy the pixels can go
+  // straight from the render target into that texture.
+  if (GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled()) {
+    forward_reject_reason_ = "path";
+    return false;
+  }
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  const draw_util::ResolveCopyDestCoordinateInfo dest_coordinates =
+      resolve_info.copy_dest_coordinate_info;
+  const draw_util::ResolveEdramInfo edram =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  // The texture format the destination is read as. Depth is read as R32
+  // float on the host (texture_cache.cpp), which is what the depth render
+  // target holds, so forwarding it only skips the 24-bit rounding the guest
+  // format would add.
+  xenos::TextureFormat texture_format;
+  if (is_depth) {
+    if (xenos::DepthRenderTargetFormat(edram.format) == xenos::DepthRenderTargetFormat::kD24S8 &&
+        uint32_t(dest_info.copy_dest_format) == uint32_t(xenos::TextureFormat::k_24_8)) {
+      texture_format = xenos::TextureFormat::k_24_8;
+    } else if (xenos::DepthRenderTargetFormat(edram.format) ==
+                   xenos::DepthRenderTargetFormat::kD24FS8 &&
+               uint32_t(dest_info.copy_dest_format) ==
+                   uint32_t(xenos::TextureFormat::k_24_8_FLOAT)) {
+      texture_format = xenos::TextureFormat::k_24_8_FLOAT;
+    } else {
+      forward_reject_reason_ = "depth format";
+      return false;
+    }
+  } else {
+    if (dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 || edram.format_is_64bpp ||
+        xenos::ColorRenderTargetFormat(edram.format) !=
+            xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+      forward_reject_reason_ = "color format";
+      return false;
+    }
+    texture_format = xenos::TextureFormat::k_8_8_8_8;
+  }
