+                       "Log draw census request and completion counters");
+
+REXCVAR_DEFINE_INT32(gpu_census_auto_swap, 0, "GPU/Vulkan",
+                     "Request one census capture when the guest reaches this swap; 0 = off. "
+                     "For consoles with no debug console to issue gpu_census_capture.");
+
+bool HasPendingRequest() { return g_requests_pending.load(std::memory_order_acquire) != 0; }
+
