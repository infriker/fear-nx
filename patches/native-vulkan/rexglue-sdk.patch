+static inline void CPU_ZERO(cpu_set_t* s) { s->bits = 0; }
+static inline void CPU_SET(int cpu, cpu_set_t* s) {
+    if (cpu >= 0 && cpu < CPU_SETSIZE) s->bits |= (uint64_t)1 << cpu;
