+#include <array>
+
+#include "common/bit_field.h"
+#include "common/common_types.h"
+#include "shader_recompiler/frontend/maxwell/translate/impl/impl.h"
+
+namespace Shader::Maxwell {
+
+void TranslatorVisitor::PRMT_imm(u64 insn) {
+    union {
+        u64 raw;
+        BitField<0, 8, IR::Reg> dest_reg;
+        BitField<8, 8, IR::Reg> src_a;
+        BitField<20, 16, u64> selector;
+        BitField<39, 8, IR::Reg> src_b;
+        BitField<48, 3, u64> mode;
+    } const prmt{insn};
+
+    if (prmt.mode != 0) {
+        throw NotImplementedException("PRMT immediate mode {}", prmt.mode);
+    }
+
+    const std::array<IR::U32, 2> sources{X(prmt.src_a), X(prmt.src_b)};
+    const IR::U32 zero{ir.Imm32(0)};
+    const IR::U32 one{ir.Imm32(1)};
+    IR::U32 result{zero};
+
+    for (u32 output_byte = 0; output_byte < 4; ++output_byte) {
+        const u32 select{static_cast<u32>((prmt.selector >> (output_byte * 4)) & 0xf)};
+        const u32 source_index{(select >> 2) & 1};
+        const u32 byte_index{select & 0x3};
+        IR::U32 byte{ir.BitFieldExtract(sources[source_index], ir.Imm32(byte_index * 8),
+                                        ir.Imm32(8), false)};
+
+        if ((select & 0x8) != 0) {
+            const IR::U32 sign_bit{ir.BitFieldExtract(byte, ir.Imm32(7), one, false)};
+            const IR::U1 is_negative{ir.IEqual(sign_bit, one)};
+            byte = IR::U32{ir.Select(is_negative, ir.Imm32(0xff), zero)};
+        }
+
+        const IR::U32 shifted{ir.ShiftLeftLogical(byte, ir.Imm32(output_byte * 8))};
+        result = ir.BitwiseOr(result, shifted);
+    }
+
+    X(prmt.dest_reg, result);
+}
+
+} // namespace Shader::Maxwell
