 void ReturnFromException(Core::System& system, Result result) {
-    UNIMPLEMENTED();
+    auto& kernel = system.Kernel();
+    auto& process = GetCurrentProcess(kernel);
+    // Keep the existing path for titles and CPU architectures outside the
+    // homebrew compatibility implementation.
+    if (!process.IsHbl() || !process.Is64Bit()) {
+        UNIMPLEMENTED();
+        return;
+    }
+    auto* thread = GetCurrentThreadPointer(kernel);
+    if (process.GetExceptionThread() != thread) {
+        StopInvalidUserException(system, "SVC 0x28 without an active user exception");
+        return;
+    }
+
+    const u64 frame_address =
+        GetInteger(process.GetProcessLocalRegionAddress()) + ExceptionFrameOffset;
+    UserExceptionFrame64 frame{};
+    if (!process.GetMemory().ReadBlock(frame_address, &frame, sizeof(frame))) {
+        process.LeaveUserException();
+        StopInvalidUserException(system, "unreadable user exception frame");
+        return;
+    }
+    // Preserve the handler's live x9-x29, vectors, FPCR and FPSR. libnx's
+    // entry saves these in its dump; they are not part of this ABI frame.
+    kernel.CurrentPhysicalCore().SaveContext(thread);
+    auto& restored = thread->GetContext();
+    std::copy(frame.r.begin(), frame.r.end(), restored.r.begin());
+    restored.lr = frame.lr;
+    restored.sp = frame.sp;
+    restored.pc = frame.pc;
+    restored.pstate = frame.pstate & UserPstateMask;
+    restored.tpidr = 1;
+    kernel.CurrentPhysicalCore().LoadContext(thread);
+
+    // Publish the restored CPU state before waking another exception waiter;
+    // scheduler unload must not overwrite it with the old SVC context.
+    process.LeaveUserException();
+    if (result.raw != 0) {
+        LOG_ERROR(Kernel_SVC, "Homebrew exception was not handled: result={:#x}", result.raw);
+        StopInvalidUserException(system, "handler requested debugger/fatal reporting");
+    }
 }
 
