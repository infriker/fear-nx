+static uint32_t
+nvkmd_switch_horizon_engine_mask(enum nvkmd_engines engines)
+{
+   uint32_t mask = 0;
+   if (engines & NVKMD_ENGINE_COPY)
+      mask |= NOUVEAU_HORIZON_ENGINE_COPY;
+   if (engines & NVKMD_ENGINE_2D)
+      mask |= NOUVEAU_HORIZON_ENGINE_2D;
+   if (engines & NVKMD_ENGINE_3D)
+      mask |= NOUVEAU_HORIZON_ENGINE_3D;
+   if (engines & NVKMD_ENGINE_M2MF)
+      mask |= NOUVEAU_HORIZON_ENGINE_M2MF;
+   if (engines & NVKMD_ENGINE_COMPUTE)
+      mask |= NOUVEAU_HORIZON_ENGINE_COMPUTE;
+   return mask;
+}
