    bool last_fence_valid;
    bool last_fence_cpu_visible;
    bool lost;
@@ -196,6 +197,7 @@ struct nouveau_horizon_channel {
    uint32_t *builtin_cpu;
    uint64_t builtin_addr;
 
+   uint32_t bind_3d_offset_words;
    uint32_t cache_acquire_offset_words;
