+        BitField<41, 1, u64> rhs_signed;
+    } const imul{insn};
+    IMUL(*this, insn, GetCbuf(insn), imul.high != 0, imul.lhs_signed != 0,
+         imul.rhs_signed != 0);
+}
+
+void TranslatorVisitor::IMUL_imm(u64 insn) {
+    union {
+        u64 raw;
+        BitField<39, 1, u64> high;
+        BitField<40, 1, u64> lhs_signed;
+        BitField<41, 1, u64> rhs_signed;
+    } const imul{insn};
+    IMUL(*this, insn, GetImm20(insn), imul.high != 0, imul.lhs_signed != 0,
+         imul.rhs_signed != 0);
+}
+
+void TranslatorVisitor::IMUL32I(u64 insn) {
+    union {
+        u64 raw;
+        BitField<53, 1, u64> high;
+        BitField<54, 1, u64> lhs_signed;
+        BitField<55, 1, u64> rhs_signed;
+    } const imul{insn};
+    IMUL(*this, insn, GetImm32(insn), imul.high != 0, imul.lhs_signed != 0,
+         imul.rhs_signed != 0);
+}
+
