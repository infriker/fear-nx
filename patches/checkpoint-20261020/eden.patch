+    constexpr u64 initial_samples = 4;
+    constexpr u64 cadence = 120;
+    constexpr u64 max_samples = 60;
+    return sequence <= initial_samples ||
+           (sequence <= initial_samples + (max_samples - initial_samples) * cadence &&
+            (sequence - initial_samples) % cadence == 0);
+}
