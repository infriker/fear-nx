+struct DisplayByteSample {
+    u32 nonzero{};
+    u64 hash{14695981039346656037ULL};
+};
+
+DisplayByteSample SampleDisplayBytes(const u8* data, u64 size) {
+    DisplayByteSample sample{};
+    if (!data || size == 0) {
+        return sample;
+    }
+
+    constexpr u32 sample_count = 64;
+    for (u32 i = 0; i < sample_count; ++i) {
+        const u64 offset = (size - 1) * i / (sample_count - 1);
+        const u8 value = data[offset];
+        sample.nonzero += value != 0;
+        sample.hash ^= value;
+        sample.hash *= 1099511628211ULL;
+    }
+    return sample;
+}
+
+u64 NextDisplayDiagnosticSequence() {
+    static std::atomic<u64> sequence{0};
+    return sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
