 namespace Kernel::Svc {
 
+namespace {
+// Horizon's AArch64 frame in the process local region. x9-x29 and SIMD/FP
+// state remain in the live CPU context; the libnx entry saves them itself.
+// ABI reference: https://switchbrew.org/wiki/SVC#Exception_handling
+struct UserExceptionFrame64 {
+    std::array<u64, 9> r;
+    u64 lr;
+    u64 sp;
+    u64 pc;
+    u32 pstate;
+    u32 afsr0;
+    u32 afsr1;
+    u32 esr;
+    u64 fault_address;
+};
+static_assert(sizeof(UserExceptionFrame64) == 0x78);
+static_assert(offsetof(UserExceptionFrame64, lr) == 0x48);
+static_assert(offsetof(UserExceptionFrame64, pc) == 0x58);
+static_assert(offsetof(UserExceptionFrame64, esr) == 0x6c);
+static_assert(offsetof(UserExceptionFrame64, fault_address) == 0x70);
+constexpr u64 ExceptionFrameOffset = 0x148;
+constexpr u32 UserPstateMask = 0xff0ffe20;
+
+void StopInvalidUserException(Core::System& system, const char* reason) {
+    auto* thread = GetCurrentThreadPointer(system.Kernel());
+    LOG_CRITICAL(Kernel_SVC, "Homebrew user exception cannot resume: {}", reason);
+    system.Kernel().CurrentPhysicalCore().LogBacktrace();
+    if (system.DebuggerEnabled()) {
+        system.GetDebugger().NotifyThreadStopped(thread);
+    }
+    thread->RequestSuspend(SuspendType::Debug);
+}
+} // namespace
+
+bool DeliverUserException(Core::System& system, const Core::GuestExceptionInfo& exception,
+                          const ThreadContext& context) {
+    auto& kernel = system.Kernel();
+    auto& process = GetCurrentProcess(kernel);
+    if (!process.IsHbl() || !process.Is64Bit()) {
+        return false;
+    }
+    auto* thread = GetCurrentThreadPointer(kernel);
+    auto& memory = process.GetMemory();
+    const u64 frame_address =
+        GetInteger(process.GetProcessLocalRegionAddress()) + ExceptionFrameOffset;
+    const u64 entry = GetInteger(process.GetEntryPoint());
+    if (!memory.IsValidVirtualAddressRange(frame_address, sizeof(UserExceptionFrame64)) ||
+        !memory.IsValidVirtualAddressRange(entry, sizeof(u32))) {
+        LOG_ERROR(Kernel_SVC, "Invalid homebrew exception entry/frame: {:#x}/{:#x}",
+                  entry, frame_address);
+        return false;
+    }
+
+    // This may wait and migrate the thread to another core. No cached ARM
+    // interface may be used after it; the original CPU state is a value copy.
+    if (!process.EnterUserException()) {
+        LOG_ERROR(Kernel_SVC, "Could not acquire homebrew user-exception ownership");
+        return false;
+    }
+    UserExceptionFrame64 frame{};
+    std::copy_n(context.r.begin(), frame.r.size(), frame.r.begin());
+    frame.lr = context.lr;
+    frame.sp = context.sp;
+    frame.pc = exception.pc;
+    frame.pstate = context.pstate & UserPstateMask;
+    frame.esr = exception.esr;
+    frame.fault_address = exception.fault_address;
+    if (!memory.WriteBlock(frame_address, &frame, sizeof(frame))) {
+        process.LeaveUserException();
+        return false;
+    }
+
+    auto& handler = thread->GetContext();
+    handler = context;
+    handler.r[0] = static_cast<u32>(exception.description);
+    handler.r[1] = frame_address;
+    handler.sp = frame_address;
+    handler.pc = entry;
+    handler.pstate &= UserPstateMask;
+    kernel.CurrentPhysicalCore().LoadContext(thread);
+    LOG_DEBUG(Kernel_SVC, "Homebrew exception {:#x}: pc={:#x} fault_address={:#x} esr={:#x}",
+              static_cast<u32>(exception.description), frame.pc, frame.fault_address, frame.esr);
+    return true;
+}
