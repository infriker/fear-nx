+#include "common/common_types.h"
+#include "shader_recompiler/frontend/maxwell/translate/impl/impl.h"
+
+namespace Shader::Maxwell {
+namespace {
+
+IR::U32 MultiplyHighUnsigned(TranslatorVisitor& v, const IR::U32& lhs, const IR::U32& rhs) {
+    const IR::U32 zero{v.ir.Imm32(0)};
+    const IR::U32 sixteen{v.ir.Imm32(16)};
+    const IR::U32 lhs_low{v.ir.BitFieldExtract(lhs, zero, sixteen, false)};
+    const IR::U32 lhs_high{v.ir.ShiftRightLogical(lhs, sixteen)};
+    const IR::U32 rhs_low{v.ir.BitFieldExtract(rhs, zero, sixteen, false)};
+    const IR::U32 rhs_high{v.ir.ShiftRightLogical(rhs, sixteen)};
+
+    const IR::U32 low_product{v.ir.IMul(lhs_low, rhs_low)};
+    const IR::U32 low_high{v.ir.ShiftRightLogical(low_product, sixteen)};
+    const IR::U32 cross_lh{v.ir.IMul(lhs_low, rhs_high)};
+    const IR::U32 cross_hl{v.ir.IMul(lhs_high, rhs_low)};
+    const IR::U32 cross_low_sum{v.ir.IAdd(
+        low_high,
+        v.ir.IAdd(v.ir.BitFieldExtract(cross_lh, zero, sixteen, false),
+                  v.ir.BitFieldExtract(cross_hl, zero, sixteen, false)))};
+    const IR::U32 carry{v.ir.ShiftRightLogical(cross_low_sum, sixteen)};
+
+    const IR::U32 high_product{v.ir.IMul(lhs_high, rhs_high)};
+    const IR::U32 cross_lh_high{v.ir.ShiftRightLogical(cross_lh, sixteen)};
+    const IR::U32 cross_hl_high{v.ir.ShiftRightLogical(cross_hl, sixteen)};
+    return v.ir.IAdd(v.ir.IAdd(high_product, cross_lh_high),
+                     v.ir.IAdd(cross_hl_high, carry));
+}
+
+IR::U32 MultiplyHigh(TranslatorVisitor& v, const IR::U32& lhs, const IR::U32& rhs,
+                     bool lhs_signed, bool rhs_signed) {
+    IR::U32 result{MultiplyHighUnsigned(v, lhs, rhs)};
+    const IR::U32 zero{v.ir.Imm32(0)};
+    const IR::U32 one{v.ir.Imm32(1)};
+    const IR::U32 thirty_one{v.ir.Imm32(31)};
+
+    if (lhs_signed) {
+        const IR::U32 sign_bit{v.ir.BitFieldExtract(lhs, thirty_one, one, false)};
+        const IR::U1 is_negative{v.ir.IEqual(sign_bit, one)};
+        const IR::U32 correction{v.ir.Select(is_negative, rhs, zero)};
+        result = v.ir.IAdd(result, v.ir.INeg(correction));
+    }
+    if (rhs_signed) {
+        const IR::U32 sign_bit{v.ir.BitFieldExtract(rhs, thirty_one, one, false)};
+        const IR::U1 is_negative{v.ir.IEqual(sign_bit, one)};
+        const IR::U32 correction{v.ir.Select(is_negative, lhs, zero)};
+        result = v.ir.IAdd(result, v.ir.INeg(correction));
+    }
+    return result;
+}
+
+void IMUL(TranslatorVisitor& v, u64 insn, IR::U32 op_b, bool high, bool lhs_signed,
+          bool rhs_signed) {
+    union {
+        u64 raw;
+        BitField<0, 8, IR::Reg> dest_reg;
+        BitField<8, 8, IR::Reg> src_a;
+    } const imul{insn};
+
+    const IR::U32 op_a{v.X(imul.src_a)};
+    const IR::U32 result{high ? MultiplyHigh(v, op_a, op_b, lhs_signed, rhs_signed)
+                              : v.ir.IMul(op_a, op_b)};
+    v.X(imul.dest_reg, result);
+}
+
+} // Anonymous namespace
+
+void TranslatorVisitor::IMUL_reg(u64 insn) {
+    union {
+        u64 raw;
+        BitField<39, 1, u64> high;
+        BitField<40, 1, u64> lhs_signed;
+        BitField<41, 1, u64> rhs_signed;
+    } const imul{insn};
+    IMUL(*this, insn, GetReg20(insn), imul.high != 0, imul.lhs_signed != 0,
+         imul.rhs_signed != 0);
+}
+
