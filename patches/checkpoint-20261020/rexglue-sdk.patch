+void VulkanPipelineCache::InitializeDriverCache(const std::filesystem::path& root,
+                                                uint32_t title_id) {
+  std::lock_guard lock(driver_cache_mutex_);
+  const auto* vulkan_device = command_processor_.GetVulkanDevice();
+  const auto& dfn = vulkan_device->functions();
+  const auto device = vulkan_device->device();
+  if (driver_cache_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyPipelineCache(device, driver_cache_, nullptr);
+    driver_cache_ = VK_NULL_HANDLE;
+  }
+  driver_cache_generation_ = 0;
+  driver_cache_saved_generation_ = 0;
+  driver_cache_save_time_ = std::chrono::steady_clock::now();
+  driver_cache_path_.clear();
+  std::error_code error;
+  auto directory = root / "shaders" / "driver";
+  std::filesystem::create_directories(directory, error);
+  if (!error) {
+    const auto& props = vulkan_device->properties();
+    driver_cache_path_ = directory / fmt::format("{:08X}-{:08X}-{:08X}-{:08X}.cache",
+        title_id, props.vendorID, props.deviceID, props.driverVersion);
+  }
+
+  // Never pass a partial SD write to the driver. The envelope stores a length
+  // and checksum around the exact bytes returned by vkGetPipelineCacheData.
+  // Vulkan itself checks the cache UUID when the driver build changes.
+  auto read_cache = [](const std::filesystem::path& path) {
+    std::vector<uint8_t> bytes;
+    if (FILE* file = rex::filesystem::OpenFile(path, "rb")) {
+      uint64_t header[3]{};
+      if (fread(header, sizeof(header), 1, file) == 1 &&
+          header[0] == 0x3148434143385052ULL && header[1] >= 32 &&
+          header[1] <= 64 * 1024 * 1024) {
+        bytes.resize(size_t(header[1]));
+        if (fread(bytes.data(), bytes.size(), 1, file) != 1 ||
+            XXH3_64bits(bytes.data(), bytes.size()) != header[2]) {
+          bytes.clear();
+        }
+      }
+      fclose(file);
+    }
+    return bytes;
+  };
+  std::vector<uint8_t> data;
+  if (!driver_cache_path_.empty()) {
+    // The Switch file system does not replace an existing file on rename, so
+    // a save that got as far as the complete temporary file (its checksum
+    // proves that) is newer than the main one: use whichever valid copy holds
+    // more pipelines.
+    data = read_cache(driver_cache_path_);
+    for (const char* suffix : {".tmp", ".old"}) {
+      auto other_path = driver_cache_path_;
+      other_path += suffix;
+      std::vector<uint8_t> other = read_cache(other_path);
+      if (other.size() > data.size()) {
+        data = std::move(other);
+      }
+    }
+  }
+  VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = data.size();
+  info.pInitialData = data.empty() ? nullptr : data.data();
+  VkResult result = dfn.vkCreatePipelineCache(device, &info, nullptr, &driver_cache_);
+  if (result != VK_SUCCESS && !data.empty()) {
+    data.clear();
+    info.initialDataSize = 0;
+    info.pInitialData = nullptr;
+    result = dfn.vkCreatePipelineCache(device, &info, nullptr, &driver_cache_);
+  }
+  if (result != VK_SUCCESS) {
+    driver_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("Switch driver pipeline cache unavailable ({})", int32_t(result));
+  } else {
+    REXGPU_INFO("Switch driver pipeline cache: loaded {} bytes", data.size());
+    size_t loaded_size = 0;
+    if (dfn.vkGetPipelineCacheData(device, driver_cache_, &loaded_size, nullptr) == VK_SUCCESS) {
+      driver_cache_saved_size_ = loaded_size;
+    }
+  }
+}
+
+void VulkanPipelineCache::SaveDriverCache() {
+  driver_cache_save_time_ = std::chrono::steady_clock::now();
+  std::vector<uint8_t> data;
+  uint64_t generation;
+  {
+    std::lock_guard lock(driver_cache_mutex_);
+    generation = driver_cache_generation_.load(std::memory_order_relaxed);
+    if (driver_cache_ == VK_NULL_HANDLE || driver_cache_path_.empty() ||
+        generation == driver_cache_saved_generation_) return;
+    const auto* device = command_processor_.GetVulkanDevice();
+    const auto& dfn = device->functions();
+    size_t size = 0;
+    if (dfn.vkGetPipelineCacheData(device->device(), driver_cache_, &size, nullptr) !=
+            VK_SUCCESS || size < 32 || size > 64 * 1024 * 1024) return;
+    // Every pipeline creation counts as a change, cache hits included, but
+    // the cache only grows: the same size means nothing new was compiled.
+    // Without this the whole cache, tens of megabytes, was copied and written
+    // to the SD card every 30 seconds of play.
+    if (size == driver_cache_saved_size_) {
+      driver_cache_saved_generation_ = generation;
+      return;
+    }
+    data.resize(size);
+    if (dfn.vkGetPipelineCacheData(device->device(), driver_cache_, &size, data.data()) !=
+        VK_SUCCESS) return;
+    data.resize(size);
+  }
+  auto temporary = driver_cache_path_;
+  temporary += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temporary, "wb");
+  if (!file) return;
+  const uint64_t header[] = {0x3148434143385052ULL, uint64_t(data.size()),
+                            XXH3_64bits(data.data(), data.size())};
+  bool written = fwrite(header, sizeof(header), 1, file) == 1 &&
+                 fwrite(data.data(), data.size(), 1, file) == 1;
+  if (fclose(file) != 0) written = false;
+  // Keep the previous cache intact if writing or replacing it fails.
+  if (written) {
+    // Horizon's file system refuses to rename onto an existing file, which
+    // left every save stranded in the temporary file and each launch loading
+    // the first, small cache. Move the old file aside first.
+    std::error_code error;
+    std::filesystem::rename(temporary, driver_cache_path_, error);
+    if (error) {
+      auto previous = driver_cache_path_;
+      previous += ".old";
+      std::error_code ignored;
+      std::filesystem::remove(previous, ignored);
+      std::filesystem::rename(driver_cache_path_, previous, ignored);
+      error.clear();
+      std::filesystem::rename(temporary, driver_cache_path_, error);
+      if (!error) {
+        std::filesystem::remove(previous, ignored);
+      }
+    }
+    if (!error) {
+      driver_cache_saved_generation_ = generation;
+      driver_cache_saved_size_ = data.size();
+      REXGPU_INFO("Switch driver pipeline cache: saved {} bytes", data.size());
+    }
+  }
+}
