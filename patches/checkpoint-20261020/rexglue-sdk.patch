+uint32_t VulkanRenderTargetCache::GetDrawOverwrittenRenderTargets(
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    Transfer::Rectangle& rect_out, const Shader* vertex_shader) {
+  // Direct3D on the Xbox 360 clears by drawing one screen-space rectangle
+  // over the scissor with depth and stencil forced. Binding the render targets
+  // for that draw is what makes the EDRAM change owner, so without this every
+  // pass began by converting the previous owner's samples (in this game, 8-bit
+  // color into float depth, then back) only for the clear to overwrite them.
+  // The rectangle is taken to cover the scissor, which is how Direct3D sets up
+  // its clears, and a clear's pixel shader samples no textures. Opaque images
+  // and video frames are also single rectangles, often smaller than the
+  // scissor; treating those as clears left stale content around them. Every
+  // other condition guarantees that each sample inside is written.
+  const RegisterFile& regs = register_file();
+  const auto draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      draw_initiator.num_indices != 3 || draw_pixel_shader_kills_) {
+    return 0;
+  }
+  // A textured rectangle (post-processing passes draw one over the whole
+  // screen, into memory that held the scene's depth) only counts when its
+  // vertices, not the scissor, show it covers everything; images and video
+  // frames are rectangles smaller than the scissor.
+  const bool textured = draw_pixel_shader_samples_textures_;
+  if (textured && (!REXCVAR_GET(gpu_skip_transfers_under_opaque_rects) || !vertex_shader)) {
+    return 0;
+  }
+  // Alpha test and alpha to coverage act on the pixel shader's color output,
+  // which a depth-only draw does not have (the shadow map clears here leave
+  // the alpha test enabled from earlier draws).
+  const auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kColorDepth &&
+      ((color_control.alpha_test_enable &&
+        color_control.alpha_func != xenos::CompareFunction::kAlways) ||
+       color_control.alpha_to_mask_enable)) {
+    return 0;
+  }
+  const auto msaa_samples = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+  const uint32_t sample_bits = (uint32_t(1) << (uint32_t(1) << uint32_t(msaa_samples))) - 1;
+  if ((regs[XE_GPU_REG_PA_SC_AA_MASK] & sample_bits) != sample_bits) {
+    return 0;
+  }
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor, true);
+  if (!scissor.extent[0] || !scissor.extent[1]) {
+    return 0;
+  }
+  if (textured &&
+      !RectangleCoversPixels(*vertex_shader, int32_t(scissor.offset[0]),
+                             int32_t(scissor.offset[1]),
+                             int32_t(scissor.offset[0] + scissor.extent[0]),
+                             int32_t(scissor.offset[1] + scissor.extent[1]))) {
+    return 0;
+  }
+  rect_out.x_pixels = scissor.offset[0];
+  rect_out.y_pixels = scissor.offset[1];
+  rect_out.width_pixels = scissor.extent[0];
+  rect_out.height_pixels = scissor.extent[1];
+  // The EDRAM pitch is the surface width rounded up to whole 80-sample tiles.
+  // A clear reaching into the last tile column has only that padding to its
+  // right, which nothing draws or resolves; transferring it would still cost a
+  // full set of transfer passes (1024 wide shadow maps on a 1040 pitch here).
+  {
+    const uint32_t tile_width_pixels =
+        xenos::kEdramTileWidthSamples >> uint32_t(msaa_samples >= xenos::MsaaSamples::k4X);
+    const uint32_t tile_height_pixels =
+        xenos::kEdramTileHeightSamples >> uint32_t(msaa_samples >= xenos::MsaaSamples::k2X);
+    const uint32_t pitch_pixels = rex::round_up(
+        uint32_t(regs.Get<reg::RB_SURFACE_INFO>().surface_pitch), tile_width_pixels);
+    const uint32_t right = rect_out.x_pixels + rect_out.width_pixels;
+    if (right < pitch_pixels && pitch_pixels - right < tile_width_pixels) {
+      rect_out.width_pixels = pitch_pixels - rect_out.x_pixels;
+    }
+    rect_out.height_pixels =
+        rex::round_up(rect_out.y_pixels + rect_out.height_pixels, tile_height_pixels) -
+        rect_out.y_pixels;
+  }
+
+  uint32_t overwritten = 0;
+  const reg::RB_DEPTHCONTROL& depth = normalized_depth_control;
+  // With both tests always passing, only the depth-pass stencil operation runs.
+  auto stencil_replaced = [](xenos::CompareFunction func, xenos::StencilOp zpass,
+                             reg::RB_STENCILREFMASK ref_mask) {
+    return func == xenos::CompareFunction::kAlways && zpass == xenos::StencilOp::kReplace &&
+           ref_mask.stencilwritemask == 0xFF;
+  };
+  if (depth.z_enable && depth.z_write_enable && depth.zfunc == xenos::CompareFunction::kAlways &&
+      depth.stencil_enable &&
+      stencil_replaced(depth.stencilfunc, depth.stencilzpass,
+                       regs.Get<reg::RB_STENCILREFMASK>()) &&
+      (!depth.backface_enable ||
+       stencil_replaced(depth.stencilfunc_bf, depth.stencilzpass_bf,
+                        regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF)))) {
+    overwritten |= 1;
+  }
+  // A depth or stencil test could reject color samples.
+  const bool color_unconditional =
+      (!depth.z_enable || depth.zfunc == xenos::CompareFunction::kAlways) &&
+      (!depth.stencil_enable ||
+       (depth.stencilfunc == xenos::CompareFunction::kAlways &&
+        (!depth.backface_enable || depth.stencilfunc_bf == xenos::CompareFunction::kAlways)));
+  for (uint32_t i = 0; color_unconditional && i < xenos::kMaxColorRenderTargets; ++i) {
+    if (((normalized_color_mask >> (4 * i)) & 0xF) != 0xF) {
+      continue;
+    }
+    const auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    if (blend.color_srcblend != xenos::BlendFactor::kOne ||
+        blend.color_destblend != xenos::BlendFactor::kZero ||
+        blend.color_comb_fcn != xenos::BlendOp::kAdd ||
+        blend.alpha_srcblend != xenos::BlendFactor::kOne ||
+        blend.alpha_destblend != xenos::BlendFactor::kZero ||
+        blend.alpha_comb_fcn != xenos::BlendOp::kAdd) {
+      continue;
+    }
+    overwritten |= uint32_t(1) << (1 + i);
+  }
+  return overwritten;
+}
+
+bool VulkanRenderTargetCache::RectangleCoversPixels(const Shader& vertex_shader, int32_t x0,
+                                                    int32_t y0, int32_t x1, int32_t y1) {
+  const RegisterFile& regs = register_file();
+  const auto draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (draw_initiator.source_select != xenos::SourceSelect::kAutoIndex ||
+      !vertex_shader.is_ucode_analyzed() ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+  class PositionSink : public ShaderInterpreter::ExportSink {
+   public:
+    void Export(ucode::ExportRegister export_register, const float* value,
+                uint32_t value_mask) override {
+      if (export_register == ucode::ExportRegister::kVSPosition) {
+        for (uint32_t i = 0; i < 4; ++i) {
+          if (value_mask & (1u << i)) {
+            position[i] = value[i];
+            written |= 1u << i;
+          }
+        }
+      }
+    }
+    float position[4] = {};
+    uint32_t written = 0;
+  };
+  // The same screen-space mapping as the draw extent estimator: optional
+  // division by W, the viewport, the Direct3D half-pixel offset and the window
+  // offset, leaving pixel (x, y) spanning [x, x + 1) x [y, y + 1).
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const float scale_x =
+      vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  const float offset_x =
+      vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  const float scale_y =
+      vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  const float offset_y =
+      vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  float pixel_offset_x = 0.0f, pixel_offset_y = 0.0f;
+  if (regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    pixel_offset_x = pixel_offset_y = 0.5f;
+  }
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    pixel_offset_x += float(window_offset.window_x_offset);
+    pixel_offset_y += float(window_offset.window_y_offset);
+  }
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  float xs[3], ys[3];
+  PositionSink sink;
+  rectangle_interpreter_.SetShader(vertex_shader);
+  rectangle_interpreter_.SetExportSink(&sink);
+  bool valid = true;
+  for (uint32_t i = 0; i < 3 && valid; ++i) {
+    const uint32_t vertex_index =
+        std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    sink.written = 0;
+    rectangle_interpreter_.temp_registers()[0] = float(vertex_index);
+    rectangle_interpreter_.Execute();
+    if ((sink.written & 0b0011) != 0b0011) {
+      valid = false;
+      break;
+    }
+    float x = sink.position[0], y = sink.position[1];
+    if (!vte.vtx_xy_fmt) {
+      if (!(sink.written & 0b1000) || !(sink.position[3] > 0.0f)) {
+        valid = false;
+        break;
+      }
+      x /= sink.position[3];
+      y /= sink.position[3];
+    }
+    xs[i] = x * scale_x + offset_x + pixel_offset_x;
+    ys[i] = y * scale_y + offset_y + pixel_offset_y;
+    if (!std::isfinite(xs[i]) || !std::isfinite(ys[i])) {
+      valid = false;
+    }
+  }
+  rectangle_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  // Axis-aligned: the three corners use two distinct X and two distinct Y.
+  const float min_x = std::min({xs[0], xs[1], xs[2]}), max_x = std::max({xs[0], xs[1], xs[2]});
+  const float min_y = std::min({ys[0], ys[1], ys[2]}), max_y = std::max({ys[0], ys[1], ys[2]});
+  for (uint32_t i = 0; i < 3; ++i) {
+    if ((xs[i] != min_x && xs[i] != max_x) || (ys[i] != min_y && ys[i] != max_y)) {
+      return false;
+    }
+  }
+  // Whole pixel squares, so every MSAA sample position inside is covered.
+  return min_x <= float(x0) && max_x >= float(x1) && min_y <= float(y0) && max_y >= float(y1);
+}
+
+void VulkanRenderTargetCache::CopyDepthTransfers(VulkanRenderTarget& dest_rt,
+                                                 const std::vector<Transfer>& transfers,
+                                                 std::vector<Transfer>& remaining_out) {
+  // Without VK_EXT_shader_stencil_export a depth transfer is one draw for depth
+  // and eight more for stencil, one per bit, each running the whole EDRAM
+  // addressing shader over the range. On the Switch those stencil draws were
+  // the largest single share of GPU time in a menu frame. When both render
+  // targets store the samples in the same format and count, the transfer only
+  // moves tile runs to other coordinates, which a copy does exactly and in one
+  // pass for both aspects.
+  remaining_out.clear();
+  const RenderTargetKey dest_key = dest_rt.key();
+  const uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  const uint32_t tile_width = xenos::kEdramTileWidthSamples >>
+                              uint32_t(dest_key.msaa_samples >= xenos::MsaaSamples::k4X);
+  const uint32_t tile_height = xenos::kEdramTileHeightSamples >>
+                               uint32_t(dest_key.msaa_samples >= xenos::MsaaSamples::k2X);
+  const uint32_t dest_pitch = dest_key.GetPitchTiles();
+  const uint32_t dest_width = dest_key.GetWidth() * scale_x;
+  const uint32_t dest_height =
+      GetRenderTargetHeight(dest_key.pitch_tiles_at_32bpp, dest_key.msaa_samples) * scale_y;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+
+  for (const Transfer& transfer : transfers) {
+    auto* source_rt = static_cast<VulkanRenderTarget*>(transfer.source);
+    const RenderTargetKey source_key = source_rt->key();
+    // A separate host depth source carries more precision than the source's
+    // own samples, so those transfers stay on the shader path.
+    if (!source_key.is_depth || source_key.resource_format != dest_key.resource_format ||
+        source_key.msaa_samples != dest_key.msaa_samples ||
+        (transfer.host_depth_source && transfer.host_depth_source != transfer.source)) {
+      remaining_out.push_back(transfer);
+      continue;
+    }
+    const uint32_t source_pitch = source_key.GetPitchTiles();
+    const uint32_t source_width = source_key.GetWidth() * scale_x;
+    const uint32_t source_height =
+        GetRenderTargetHeight(source_key.pitch_tiles_at_32bpp, source_key.msaa_samples) *
+        scale_y;
+    // Tile index relative to a render target base, past the EDRAM wrap.
+    auto local = [](uint32_t tile, uint32_t base) {
+      return tile >= base ? tile - base : tile + xenos::kEdramTileCount - base;
+    };
+    copy_transfer_regions_.clear();
+    bool in_bounds = true;
+    for (uint32_t tile = transfer.start_tiles; tile < transfer.end_tiles && in_bounds;) {
+      const uint32_t dest_local = local(tile, dest_key.base_tiles);
+      const uint32_t source_local = local(tile, source_key.base_tiles);
+      const uint32_t dest_x = dest_local % dest_pitch, dest_y = dest_local / dest_pitch;
+      const uint32_t source_x = source_local % source_pitch,
+                     source_y = source_local / source_pitch;
+      uint32_t run = std::min({dest_pitch - dest_x, source_pitch - source_x,
+                               transfer.end_tiles - tile});
+      // The local index jumps back to 0 where the range crosses a base.
+      if (tile < dest_key.base_tiles) {
+        run = std::min(run, dest_key.base_tiles - tile);
+      }
+      if (tile < source_key.base_tiles) {
+        run = std::min(run, source_key.base_tiles - tile);
+      }
+      VkImageCopy region;
+      region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+      region.srcSubresource.mipLevel = 0;
+      region.srcSubresource.baseArrayLayer = 0;
+      region.srcSubresource.layerCount = 1;
+      region.dstSubresource = region.srcSubresource;
+      region.srcOffset = {int32_t(source_x * tile_width * scale_x),
+                          int32_t(source_y * tile_height * scale_y), 0};
+      region.dstOffset = {int32_t(dest_x * tile_width * scale_x),
+                          int32_t(dest_y * tile_height * scale_y), 0};
+      region.extent = {run * tile_width * scale_x, tile_height * scale_y, 1};
+      if (uint32_t(region.srcOffset.x) + region.extent.width > source_width ||
+          uint32_t(region.srcOffset.y) + region.extent.height > source_height ||
+          uint32_t(region.dstOffset.x) + region.extent.width > dest_width ||
+          uint32_t(region.dstOffset.y) + region.extent.height > dest_height) {
+        in_bounds = false;
+        break;
+      }
+      // Whole rows at the same columns in both targets merge into one region.
+      if (!copy_transfer_regions_.empty()) {
+        VkImageCopy& previous = copy_transfer_regions_.back();
+        if (previous.srcOffset.x == region.srcOffset.x &&
+            previous.dstOffset.x == region.dstOffset.x &&
+            previous.extent.width == region.extent.width &&
+            previous.srcOffset.y + int32_t(previous.extent.height) == region.srcOffset.y &&
+            previous.dstOffset.y + int32_t(previous.extent.height) == region.dstOffset.y) {
+          previous.extent.height += region.extent.height;
+          tile += run;
+          continue;
+        }
+      }
+      copy_transfer_regions_.push_back(region);
+      tile += run;
+    }
+    if (!in_bounds || copy_transfer_regions_.empty()) {
+      remaining_out.push_back(transfer);
+      continue;
+    }
+
+    const VkImageSubresourceRange depth_stencil_range = ui::vulkan::util::InitializeSubresourceRange(
+        VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+    command_processor_.PushImageMemoryBarrier(
+        source_rt->image(), depth_stencil_range, source_rt->current_stage_mask(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, source_rt->current_access_mask(),
+        VK_ACCESS_TRANSFER_READ_BIT, source_rt->current_layout(),
+        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    source_rt->SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    command_processor_.PushImageMemoryBarrier(
+        dest_rt.image(), depth_stencil_range, dest_rt.current_stage_mask(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, dest_rt.current_access_mask(),
+        VK_ACCESS_TRANSFER_WRITE_BIT, dest_rt.current_layout(),
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    dest_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    command_processor_.SubmitBarriers(true);
+    command_processor_.GpuOpBegin();
+    VkImageCopy* regions = command_buffer.CmdCopyImageEmplace(
+        source_rt->image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dest_rt.image(),
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, uint32_t(copy_transfer_regions_.size()));
+    std::memcpy(regions, copy_transfer_regions_.data(),
+                sizeof(VkImageCopy) * copy_transfer_regions_.size());
+    command_processor_.GpuOpEnd(VulkanCommandProcessor::GpuOp::kTransferCopy);
+#if REX_PLATFORM_SWITCH
+    RexSwitchPerfCount(48);
+#endif
+  }
+}
