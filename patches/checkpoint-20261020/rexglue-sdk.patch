+void SharedMemory::MarkTouched(uint32_t start, uint32_t length) {
+  if (!hoist_uploads_ || !length || start >= kBufferSize) {
+    return;
+  }
+  uint32_t end = start + std::min(length, kBufferSize - start);
+  // First range ending at or after start: the only candidates to merge with.
+  auto first = std::lower_bound(
+      touched_ranges_.begin(), touched_ranges_.end(), start,
+      [](const std::pair<uint32_t, uint32_t>& range, uint32_t value) {
+        return range.second < value;
+      });
+  if (first != touched_ranges_.end() && first->first <= start && first->second >= end) {
+    // Already inside one range: by far the most common case.
+    return;
+  }
+  auto last = first;
+  while (last != touched_ranges_.end() && last->first <= end) {
+    start = std::min(start, last->first);
+    end = std::max(end, last->second);
+    ++last;
+  }
+  if (first == last) {
+    touched_ranges_.insert(first, std::make_pair(start, end));
+    return;
+  }
+  first->first = start;
+  first->second = end;
+  touched_ranges_.erase(std::next(first), last);
+}
+
+bool SharedMemory::IsTouched(uint32_t start, uint32_t length) const {
+  const uint32_t end = start + length;
+  auto it = std::upper_bound(
+      touched_ranges_.begin(), touched_ranges_.end(), start,
+      [](uint32_t value, const std::pair<uint32_t, uint32_t>& range) {
+        return value < range.second;
+      });
+  // it: the first range ending after start.
+  return it != touched_ranges_.end() && it->first < end;
+}
