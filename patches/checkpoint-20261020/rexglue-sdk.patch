+/*
+ * Watched pages that are read over and over
+ *
+ * Desktop watches a page for CPU writes by making it read-only, so reads are
+ * free. Horizon refuses permission changes on this memory, so a watched page is
+ * unmapped and every read of it is an emulated fault. Project 8's movies and menu
+ * read watched pages about 200,000 times a second, more than two cores, and the
+ * pages were mostly ones the GPU had written: resolve readback is off, so their
+ * CPU copy is stale and invalidating them would throw away the GPU's.
+ *
+ * So a hot page is unwatched without invalidating anything, and its contents are
+ * hashed. Once per frame, from IssueSwap, each such page is hashed again; if the
+ * CPU changed it, the invalidation a CPU write would have caused happens then.
+ * The trade-off is timing: a CPU write is noticed at the next frame boundary
+ * instead of at once, so a GPU read of that page later in the same frame can see
+ * the old data. Reads themselves become native.
+ */
+bool Memory::SwitchUnwatchHotReadPage(const void* host_address) {
+  if (reinterpret_cast<uintptr_t>(host_address) < reinterpret_cast<uintptr_t>(virtual_membase_) ||
+      reinterpret_cast<uintptr_t>(host_address) >= reinterpret_cast<uintptr_t>(physical_membase_)) {
+    return false;
+  }
+  const uint32_t virtual_page = HostToGuestVirtual(host_address) & ~uint32_t(0xFFF);
+  BaseHeap* heap = LookupHeap(virtual_page);
+  if (!heap || heap->heap_type() != memory::HeapType::kGuestPhysical) {
+    return false;
+  }
+  auto* physical_heap = static_cast<PhysicalHeap*>(heap);
+  // Runs in the fault handler. Global lock first, the same order as every other
+  // path that nests them, and never block on the list: the per-frame check holds it,
+  // and a fault on the thread that holds it must fall back to emulation instead of
+  // deadlocking on itself.
+  auto global_lock = global_critical_region_.Acquire();
+  std::unique_lock<std::mutex> lock(switch_unwatched_mutex_, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return false;
+  }
+  const uint32_t physical_page = physical_heap->GetPhysicalAddress(virtual_page) & ~uint32_t(0xFFF);
+  const bool known = SwitchIsHashCheckedPage(physical_page);
+  if (!known && switch_unwatched_pages_.size() >= kSwitchMaxUnwatchedPages) {
+    return false;
+  }
+  // Another view of an already hash-checked page, or a watch set before it
+  // switched: only this view needs unmapping undone.
+  if (!physical_heap->SwitchUnwatchKeepingGpuCopy(virtual_page)) {
+    return false;
+  }
+  if (known) {
+    return true;
+  }
+  // Through the view that faulted: it was just mapped read/write, and watching it
+  // again needs the global lock held here, so this read cannot fault. The raw
+  // physical window might not be mapped yet, and a fault here would nest inside
+  // the fault handler.
+  const uint64_t hash = XXH3_64bits(TranslateVirtual(virtual_page), 0x1000);
+  switch_unwatched_pages_.push_back({virtual_page, physical_page, hash});
+  const uint32_t page = (physical_page & 0x1FFFFFFF) >> 12;
+  switch_hash_checked_[page >> 6].fetch_or(uint64_t(1) << (page & 63), std::memory_order_relaxed);
+  return true;
+}
+
+void Memory::SwitchCheckUnwatchedPages() {
+  std::vector<uint32_t> changed;
+  {
+    std::lock_guard<std::mutex> lock(switch_unwatched_mutex_);
+    auto& pages = switch_unwatched_pages_;
+    for (size_t i = 0; i < pages.size();) {
+      // The raw physical window, never write-watched: a view address could be
+      // watched (unmapped) again by now, and a fault there would re-enter the
+      // unwatch path on this thread. At worst this window faults once to be mapped,
+      // which does not touch this list.
+      const uint64_t hash = XXH3_64bits(TranslatePhysical(pages[i].physical_page), 0x1000);
+      if (hash != pages[i].hash) {
+        // Kept: the page stays hash-checked. Dropping it here meant the GPU
+        // watched it again on its next upload, and its reads faulted again, some
+        // 500 pages a second in the menu.
+        pages[i].hash = hash;
+        changed.push_back(pages[i].physical_page);
+      }
+      ++i;
+    }
+  }
+  if (changed.empty()) {
+    return;
+  }
+  // The same notification a CPU write to a watched page sends. The GPU side then
+  // re-uploads the page the next time it uses it; it does not watch it again.
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t physical_page : changed) {
+    for (auto* callback : physical_memory_invalidation_callbacks_) {
+      callback->first(callback->second, physical_page, 0x1000, true);
+    }
+  }
+}
+#endif  // REX_PLATFORM_SWITCH
+
 }  // namespace rex::memory
