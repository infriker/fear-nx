+VkDescriptorSet VulkanCommandProcessor::FindAdjacentTextureDescriptorSet(
+    bool is_vertex, VkDescriptorSetLayout descriptor_set_layout, uint32_t texture_count,
+    uint32_t sampler_count, const VkDescriptorImageInfo* texture_image_info,
+    const VkDescriptorImageInfo* sampler_image_info) const {
+  const AdjacentTextureDescriptorSetCacheEntry& entry =
+      adjacent_texture_descriptor_set_cache_[is_vertex ? 0 : 1];
+  if (!entry.valid || entry.descriptor_set_layout != descriptor_set_layout ||
+      entry.texture_infos.size() != texture_count || entry.sampler_infos.size() != sampler_count) {
+    return VK_NULL_HANDLE;
+  }
+  for (uint32_t i = 0; i < texture_count; ++i) {
+    if (entry.texture_infos[i].imageView != texture_image_info[i].imageView ||
+        entry.texture_infos[i].imageLayout != texture_image_info[i].imageLayout) {
+      return VK_NULL_HANDLE;
+    }
+  }
+  for (uint32_t i = 0; i < sampler_count; ++i) {
+    if (entry.sampler_infos[i].sampler != sampler_image_info[i].sampler) {
+      return VK_NULL_HANDLE;
+    }
+  }
+  return entry.descriptor_set;
+}
+
+void VulkanCommandProcessor::StoreAdjacentTextureDescriptorSet(
+    bool is_vertex, VkDescriptorSetLayout descriptor_set_layout, VkDescriptorSet descriptor_set,
+    uint32_t texture_count, uint32_t sampler_count, const VkDescriptorImageInfo* texture_image_info,
+    const VkDescriptorImageInfo* sampler_image_info) {
+  AdjacentTextureDescriptorSetCacheEntry& entry =
+      adjacent_texture_descriptor_set_cache_[is_vertex ? 0 : 1];
+  entry.descriptor_set_layout = descriptor_set_layout;
+  entry.descriptor_set = descriptor_set;
+  if (texture_count) {
+    entry.texture_infos.assign(texture_image_info, texture_image_info + texture_count);
+  } else {
+    entry.texture_infos.clear();
+  }
+  if (sampler_count) {
+    entry.sampler_infos.assign(sampler_image_info, sampler_image_info + sampler_count);
+  } else {
+    entry.sampler_infos.clear();
+  }
+  entry.valid = true;
+}
+
+void VulkanCommandProcessor::GpuOpBegin() {
+  if (!gpu_op_frame_sampled_ || gpu_op_count_ >= kGpuOpMaxPerFrame) {
+    return;
+  }
+  // Bottom of pipe: when everything before the operation has finished, so the
+  // pair measures the operation itself rather than the queue ahead of it.
+  const uint32_t slot = uint32_t(frame_current_ % kMaxFramesInFlight);
+  gpu_op_gap_[slot][gpu_op_count_] = gpu_op_gap_flags_;
+  gpu_op_gap_flags_ = 0;
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, timestamp_query_pool_,
+      slot * kTimestampQueriesPerFrame + 2 + 2 * gpu_op_count_);
+}
+
+void VulkanCommandProcessor::GpuOpEnd(GpuOp op) {
+  if (!gpu_op_frame_sampled_ || gpu_op_count_ >= kGpuOpMaxPerFrame) {
+    return;
+  }
+  const uint32_t slot = uint32_t(frame_current_ % kMaxFramesInFlight);
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, timestamp_query_pool_,
+      slot * kTimestampQueriesPerFrame + 3 + 2 * gpu_op_count_);
+  gpu_op_kind_[slot][gpu_op_count_++] = op;
+}
+
+void VulkanCommandProcessor::GpuOpEndDraw(uint64_t shader_pair_key, uint32_t vertex_count,
+                                          uint32_t surface_info) {
+  if (!gpu_op_frame_sampled_ || gpu_op_count_ >= kGpuOpMaxPerFrame) {
+    return;
+  }
+  const uint32_t slot = uint32_t(frame_current_ % kMaxFramesInFlight);
+  gpu_op_draw_[slot][gpu_op_count_] = {shader_pair_key, vertex_count, surface_info};
+  GpuOpEnd(GpuOp::kGuestDraw);
+}
+
+void VulkanCommandProcessor::GpuOpEndTransfer(GpuOp op, uint64_t key, uint32_t vertex_count) {
+  if (!gpu_op_frame_sampled_ || gpu_op_count_ >= kGpuOpMaxPerFrame) {
+    return;
+  }
+  const uint32_t slot = uint32_t(frame_current_ % kMaxFramesInFlight);
+  gpu_op_draw_[slot][gpu_op_count_] = {key, vertex_count, 0};
+  GpuOpEnd(op);
+}
+
+void VulkanCommandProcessor::ReportGpuDrawCosts() {
+  {
+    // Barrier batches per frame by the code that queued their first barrier,
+    // as offsets into the executable (the profiler prints its load address).
+#if REX_PLATFORM_SWITCH
+    const uintptr_t image_base = uintptr_t(&__start__);
+#else
+    const uintptr_t image_base = 0;
+#endif
+    std::vector<std::pair<uint32_t, uintptr_t>> tags;
+    uint64_t total = 0;
+    for (const auto& tag : barrier_batch_counts_) {
+      tags.emplace_back(tag.second, tag.first);
+      total += tag.second;
+    }
+    std::sort(tags.begin(), tags.end(), std::greater<>());
+    const double frames = double(gpu_draw_cost_frames_ * kGpuOpSampleEvery);
+    std::string line;
+    for (size_t k = 0; k < tags.size() && k < 12; ++k) {
+      line += fmt::format(" 0x{:X}:{:.1f}", tags[k].second - image_base,
+                          double(tags[k].first) / frames);
+    }
+    REXGPU_INFO("Barrier batches per frame {:.1f} by first pusher:{}", double(total) / frames,
+                line);
+    barrier_batch_counts_.clear();
+  }
+
+  // Which of the game's passes the GPU spends its time in. The timestamps
+  // around every draw serialize the sampled frames, so the shares, not the
+  // absolute times, are what to trust.
+  std::vector<std::pair<uint64_t, GpuDrawCost>> sorted(gpu_draw_costs_.begin(),
+                                                       gpu_draw_costs_.end());
+  std::sort(sorted.begin(), sorted.end(),
+            [](const auto& a, const auto& b) { return a.second.ns > b.second.ns; });
+  uint64_t draw_ns = 0, draws = 0;
+  for (const auto& entry : sorted) {
+    draw_ns += entry.second.ns;
+    draws += entry.second.draws;
+  }
+  const double frames = double(gpu_draw_cost_frames_);
+  REXGPU_INFO(
+      "Draw GPU cost over {} sampled frames: frame {:.1f} ms, draws {:.1f} ms in {:.0f} draws "
+      "of {} shader pairs",
+      gpu_draw_cost_frames_, double(gpu_draw_cost_frame_ns_) / frames / 1e6,
+      double(draw_ns) / frames / 1e6, double(draws) / frames, sorted.size());
+  for (size_t i = 0; i < sorted.size() && i < 20; ++i) {
+    const GpuDrawCost& cost = sorted[i].second;
+    const uint32_t pitch = cost.surface_info & 0x3FFF;
+    const uint32_t msaa = 1u << ((cost.surface_info >> 16) & 3);
+    REXGPU_INFO(
+        "  pair {:016X}: {:.2f} ms/frame ({:.0f}%), {:.1f} draws/frame, {:.0f} vertices/draw, "
+        "surface pitch {} {}x",
+        sorted[i].first, double(cost.ns) / frames / 1e6,
+        draw_ns ? 100.0 * double(cost.ns) / double(draw_ns) : 0.0, double(cost.draws) / frames,
+        cost.draws ? double(cost.vertices) / double(cost.draws) : 0.0, pitch, msaa);
+  }
+  gpu_draw_costs_.clear();
+  gpu_draw_cost_frame_ns_ = 0;
+  gpu_draw_cost_frames_ = 0;
+}
+
+void VulkanCommandProcessor::ForceSingleSampleSurface() {
+  // The game's EDRAM layout, planned for 2x, still fits with one sample (it
+  // needs half the tiles), and every consumer of the sample count - render
+  // target keys, pipelines, resolves - reads RB_SURFACE_INFO after this point.
+  // Done at the draw and the copy rather than on the register write because
+  // the bulk register path stores this register without calling
+  // WriteRegister.
+  static const bool force = REXCVAR_GET(gpu_force_1x_msaa);
+  if (force) {
+    register_file_->values[XE_GPU_REG_RB_SURFACE_INFO] &= ~(UINT32_C(3) << 16);
+  }
+}
