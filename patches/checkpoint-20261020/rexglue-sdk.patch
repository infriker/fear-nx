+VkImage VulkanTextureCache::BeginResolveForward(uint32_t base_address, uint32_t max_width,
+                                                uint32_t max_height, uint32_t pitch_texels,
+                                                xenos::TextureFormat format, xenos::Endian endian,
+                                                uint32_t& width_out, uint32_t& height_out,
+                                                VkDescriptorSet* storage_set_out) {
+  if (storage_set_out) {
+    *storage_set_out = VK_NULL_HANDLE;
+  }
+  auto* found = static_cast<VulkanTexture*>(
+      FindResolveForwardTexture(base_address, max_width, max_height, pitch_texels, format,
+                                endian));
+  if (!found || found->image() == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  const TextureKey key = found->key();
+  width_out = key.width_minus_1 + 1;
+  height_out = key.height_minus_1 + 1;
+
+  VkDescriptorSet storage_set = VK_NULL_HANDLE;
+  if (storage_set_out && found->storage_capable()) {
+    storage_set = found->GetStorageDescriptorSet();
+  }
+  const VulkanTexture::Usage new_usage = storage_set != VK_NULL_HANDLE
+                                             ? VulkanTexture::Usage::kStorageWrite
+                                             : VulkanTexture::Usage::kTransferDestination;
+  VulkanTexture::Usage old_usage = found->SetUsage(new_usage);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(new_usage, dst_stage_mask, dst_access_mask, new_layout);
+  if (storage_set_out) {
+    *storage_set_out = storage_set;
+  }
+  command_processor_.PushImageMemoryBarrier(found->image(),
+                                            ui::vulkan::util::InitializeSubresourceRange(),
+                                            src_stage_mask, dst_stage_mask, src_access_mask,
+                                            dst_access_mask, old_layout, new_layout);
+  found->MarkAsUsed();
+  MarkResolveForwardTextureUpToDate(*found);
+  return found->image();
