-Handle Proc() { return envGetOwnProcessHandle(); }
+constexpr Handle kInvalidProcessHandle = INVALID_HANDLE;
+
+struct ProcessHandleTransfer {
+    Handle server_session = INVALID_HANDLE;
+    Handle copied_process = INVALID_HANDLE;
+    Result receive_result = 0;
+    bool received_one = false;
+};
+
+std::atomic<Handle> g_process_handle{kInvalidProcessHandle};
+std::mutex g_process_handle_mutex;
+bool g_process_handle_attempted = false;
+ProcessHandleTransfer g_process_handle_transfer;
+Thread g_process_handle_receiver{};
+
+bool IsCurrentProcessHandle(Handle handle, uint64_t current_pid) {
+    if (handle == INVALID_HANDLE || handle == CUR_PROCESS_HANDLE) return false;
+    uint64_t handle_pid = 0;
+    return R_SUCCEEDED(svcGetProcessId(&handle_pid, handle)) && handle_pid == current_pid;
+}
+
+void ReceiveProcessHandle(void* arg) {
+    auto* transfer = static_cast<ProcessHandleTransfer*>(arg);
+    void* tls = armGetTls();
+    hipcMakeRequestInline(tls);
+
+    s32 index = 0;
+    transfer->receive_result = svcReplyAndReceive(
+        &index, &transfer->server_session, 1, INVALID_HANDLE, UINT64_MAX);
+    if (R_SUCCEEDED(transfer->receive_result)) {
+        HipcParsedRequest request = hipcParseRequest(tls);
+        if (request.meta.num_copy_handles == 1) {
+            transfer->copied_process = request.data.copy_handles[0];
+            transfer->received_one = true;
+        } else {
+            for (u32 i = 0; i < request.meta.num_copy_handles; ++i) {
+                Handle extra = request.data.copy_handles[i];
+                if (extra != INVALID_HANDLE) {
+                    Result close_result = svcCloseHandle(extra);
+                    if (R_FAILED(close_result)) {
+                        std::fprintf(stderr,
+                                     "[process-handle] close unexpected copy handle failed: 0x%08X\n",
+                                     unsigned(close_result));
+                    }
+                }
+            }
+        }
+    }
+
+    if (transfer->server_session != INVALID_HANDLE) {
+        Result close_result = svcCloseHandle(transfer->server_session);
+        if (R_FAILED(close_result)) {
+            std::fprintf(stderr,
+                         "[process-handle] close server session failed: 0x%08X\n",
+                         unsigned(close_result));
+        }
+        transfer->server_session = INVALID_HANDLE;
+    }
+}
+
+Handle AcquireProcessHandle() {
+    uint64_t current_pid = 0;
+    Result result = svcGetProcessId(&current_pid, CUR_PROCESS_HANDLE);
+    if (R_FAILED(result)) {
+        std::fprintf(stderr,
+                     "[process-handle] current PID query failed: 0x%08X\n",
+                     unsigned(result));
+        return kInvalidProcessHandle;
+    }
+
+    const Handle loader_handle = envGetOwnProcessHandle();
+    if (loader_handle != INVALID_HANDLE &&
+        IsCurrentProcessHandle(loader_handle, current_pid)) {
+        std::fprintf(stderr, "[process-handle] loader process handle validated\n");
+        return loader_handle;
+    }
+
+    std::fprintf(stderr,
+                 "[process-handle] loader handle unavailable or invalid; requesting self handle over loopback HIPC\n");
+
+    Handle server_session = INVALID_HANDLE;
+    Handle client_session = INVALID_HANDLE;
+    result = svcCreateSession(&server_session, &client_session, 0, 0);
+    if (R_FAILED(result)) {
+        std::fprintf(stderr,
+                     "[process-handle] create session failed: 0x%08X\n",
+                     unsigned(result));
+        if (client_session != INVALID_HANDLE) {
+            Result close_result = svcCloseHandle(client_session);
+            if (R_FAILED(close_result)) {
+                std::fprintf(stderr, "[process-handle] close partial client session failed: 0x%08X\n",
+                             unsigned(close_result));
+            }
+        }
+        if (server_session != INVALID_HANDLE) {
+            Result close_result = svcCloseHandle(server_session);
+            if (R_FAILED(close_result)) {
+                std::fprintf(stderr, "[process-handle] close partial server session failed: 0x%08X\n",
+                             unsigned(close_result));
+            }
+        }
+        return kInvalidProcessHandle;
+    }
+    if (server_session == INVALID_HANDLE || client_session == INVALID_HANDLE) {
+        std::fprintf(stderr, "[process-handle] create session returned invalid endpoint(s)\n");
+        if (client_session != INVALID_HANDLE) {
+            Result close_result = svcCloseHandle(client_session);
+            if (R_FAILED(close_result)) {
+                std::fprintf(stderr, "[process-handle] close client session failed: 0x%08X\n",
+                             unsigned(close_result));
+            }
+        }
+        if (server_session != INVALID_HANDLE) {
+            Result close_result = svcCloseHandle(server_session);
+            if (R_FAILED(close_result)) {
+                std::fprintf(stderr, "[process-handle] close server session failed: 0x%08X\n",
+                             unsigned(close_result));
+            }
+        }
+        return kInvalidProcessHandle;
+    }
+
+    g_process_handle_transfer = {};
+    g_process_handle_transfer.server_session = server_session;
+    g_process_handle_transfer.copied_process = INVALID_HANDLE;
+
+    result = threadCreate(&g_process_handle_receiver, &ReceiveProcessHandle,
+                          &g_process_handle_transfer, nullptr, 0x1000, 0x2C, -2);
+    if (R_FAILED(result)) {
+        std::fprintf(stderr,
+                     "[process-handle] create receiver thread failed: 0x%08X\n",
+                     unsigned(result));
+        Result close_client = svcCloseHandle(client_session);
+        if (R_FAILED(close_client)) {
+            std::fprintf(stderr, "[process-handle] close client session failed: 0x%08X\n",
+                         unsigned(close_client));
+        }
+        Result close_server = svcCloseHandle(server_session);
+        if (R_FAILED(close_server)) {
+            std::fprintf(stderr, "[process-handle] close server session failed: 0x%08X\n",
+                         unsigned(close_server));
+        }
+        g_process_handle_transfer.server_session = INVALID_HANDLE;
+        return kInvalidProcessHandle;
+    }
+
+    result = threadStart(&g_process_handle_receiver);
+    if (R_FAILED(result)) {
+        std::fprintf(stderr,
+                     "[process-handle] start receiver thread failed: 0x%08X\n",
+                     unsigned(result));
+        Result thread_close = threadClose(&g_process_handle_receiver);
+        if (R_FAILED(thread_close)) {
+            std::fprintf(stderr, "[process-handle] close unstarted receiver thread failed: 0x%08X\n",
+                         unsigned(thread_close));
+        }
+        Result close_client = svcCloseHandle(client_session);
+        if (R_FAILED(close_client)) {
+            std::fprintf(stderr, "[process-handle] close client session failed: 0x%08X\n",
+                         unsigned(close_client));
+        }
+        Result close_server = svcCloseHandle(server_session);
+        if (R_FAILED(close_server)) {
+            std::fprintf(stderr, "[process-handle] close server session failed: 0x%08X\n",
+                         unsigned(close_server));
+        }
+        g_process_handle_transfer.server_session = INVALID_HANDLE;
+        return kInvalidProcessHandle;
+    }
+
+    HipcMetadata request_meta{};
+    request_meta.num_copy_handles = 1;
+    HipcRequest request = hipcMakeRequest(armGetTls(), request_meta);
+    request.copy_handles[0] = CUR_PROCESS_HANDLE;
+    const Result send_result = svcSendSyncRequest(client_session);
+    const Result expected_session_closed = KERNELRESULT(ConnectionClosed);
+    if (R_FAILED(send_result) && send_result != expected_session_closed) {
+        std::fprintf(stderr,
+                     "[process-handle] send loopback request failed: 0x%08X\n",
+                     unsigned(send_result));
+    }
+    Result close_result = svcCloseHandle(client_session);
+    if (R_FAILED(close_result)) {
+        std::fprintf(stderr,
+                     "[process-handle] close client session failed: 0x%08X\n",
+                     unsigned(close_result));
+    }
+
+    const Result wait_result = threadWaitForExit(&g_process_handle_receiver);
+    if (R_FAILED(wait_result)) {
+        // Keep the static transfer state and thread object alive if an unexpected
+        // wait error leaves the receiver running; process exit reclaims its handles.
+        std::fprintf(stderr,
+                     "[process-handle] wait for receiver thread failed: 0x%08X\n",
+                     unsigned(wait_result));
+        return kInvalidProcessHandle;
+    }
+    Result thread_close = threadClose(&g_process_handle_receiver);
+    if (R_FAILED(thread_close)) {
+        std::fprintf(stderr, "[process-handle] close receiver thread failed: 0x%08X\n",
+                     unsigned(thread_close));
+    }
+
+    if (R_FAILED(g_process_handle_transfer.receive_result) ||
+        !g_process_handle_transfer.received_one) {
+        std::fprintf(stderr,
+                     "[process-handle] loopback receive failed: send=0x%08X receive=0x%08X handles=%u\n",
+                     unsigned(send_result),
+                     unsigned(g_process_handle_transfer.receive_result),
+                     g_process_handle_transfer.received_one ? 1u : 0u);
+        if (g_process_handle_transfer.copied_process != INVALID_HANDLE) {
+            Result close_process = svcCloseHandle(g_process_handle_transfer.copied_process);
+            if (R_FAILED(close_process)) {
+                std::fprintf(stderr,
+                             "[process-handle] close rejected process handle failed: 0x%08X\n",
+                             unsigned(close_process));
+            }
+            g_process_handle_transfer.copied_process = INVALID_HANDLE;
+        }
+        return kInvalidProcessHandle;
+    }
+
+    const Handle process_handle = g_process_handle_transfer.copied_process;
+    if (!IsCurrentProcessHandle(process_handle, current_pid)) {
+        std::fprintf(stderr,
+                     "[process-handle] copied handle did not identify this process\n");
+        Result close_process = svcCloseHandle(process_handle);
+        if (R_FAILED(close_process)) {
+            std::fprintf(stderr,
+                         "[process-handle] close invalid process handle failed: 0x%08X\n",
+                         unsigned(close_process));
+        }
+        g_process_handle_transfer.copied_process = INVALID_HANDLE;
+        return kInvalidProcessHandle;
+    }
+
+    // The receiver intentionally closes the server endpoint without replying.
+    // Horizon reports that successful one-way handle transfer as SessionClosed.
+    // Accept only that exact kernel result, and only after receive-count and PID
+    // validation above; every other send failure rejects and closes the handle.
+    if (R_FAILED(send_result) && send_result != expected_session_closed) {
+        std::fprintf(stderr,
+                     "[process-handle] unexpected loopback send failure: 0x%08X\n",
+                     unsigned(send_result));
+        Result close_process = svcCloseHandle(process_handle);
+        if (R_FAILED(close_process)) {
+            std::fprintf(stderr,
+                         "[process-handle] close rejected process handle failed: 0x%08X\n",
+                         unsigned(close_process));
+        }
+        g_process_handle_transfer.copied_process = INVALID_HANDLE;
+        return kInvalidProcessHandle;
+    }
+    if (send_result == expected_session_closed) {
+        std::fprintf(stderr,
+                     "[process-handle] loopback HIPC transfer complete (expected session close)\n");
+    } else {
+        std::fprintf(stderr, "[process-handle] loopback HIPC self handle acquired\n");
+    }
+    return process_handle;
+}
+
+Handle Proc() {
+    return static_cast<Handle>(RexGmProcessHandle());
+}
 
