@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <cstdint>
+#include <string_view>
+
+namespace rex::input::nx {
+constexpr uint32_t kBindingLT = 1u << 16;
+constexpr uint32_t kBindingRT = 1u << 17;
+// XInput buttons occupy the low 16 bits; digital triggers use two extra bits.
+// Unknown values inherit the standard layout so a typo cannot disable a key.
+constexpr uint32_t ResolveBinding(std::string_view name, uint32_t fallback) {
+  struct Entry { std::string_view name; uint32_t value; };
+  constexpr Entry entries[] = {
+      {"none", 0}, {"up", 1}, {"down", 2}, {"left", 4}, {"right", 8},
+      {"start", 0x10}, {"back", 0x20}, {"ls", 0x40}, {"rs", 0x80},
+      {"lb", 0x100}, {"rb", 0x200}, {"a", 0x1000}, {"b", 0x2000},
+      {"x", 0x4000}, {"y", 0x8000}, {"lt", kBindingLT}, {"rt", kBindingRT}};
+  for (const auto& entry : entries) {
+    if (name.size() != entry.name.size()) continue;
+    bool equal = true;
+    for (size_t i = 0; i < name.size(); ++i) {
+      char c = name[i];
+      if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+      if (c != entry.name[i]) { equal = false; break; }
+    }
+    if (equal) return entry.value;
+  }
+  return fallback;
+}
+}  // namespace rex::input::nx
