diff --git a/src/ui/switch_perf_disabled.cpp b/src/ui/switch_perf_disabled.cpp
new file mode 100644
--- /dev/null
+++ b/src/ui/switch_perf_disabled.cpp
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Retail build: no sampler thread, timing wrappers, counters or A/B modes.
+// Retain the presentation heartbeat used by an external SaltyNX FPS overlay.
+#include <atomic>
+#include <cstdint>
+#include "rex/ui/switch_saltynx.h"
+namespace { std::atomic<uint32_t> resolution{0}; }
+extern "C" {
+void RexSwitchPerfScheduleAb(uint32_t) {}
+void RexSwitchPerfToggleAb() {}
+void RexSwitchPerfTiron(uint64_t, uint64_t) {}
+void RexSwitchPerfResolution(unsigned width, unsigned height) {
+  resolution.store(((width & 0xffff) << 16) | (height & 0xffff), std::memory_order_relaxed);
+}
+void RexSwitchPerfIntervaloSwap(unsigned) {}
+void RexSwitchPerfCount(unsigned id) {
+  if (id == 0) {
+    const auto size = resolution.load(std::memory_order_relaxed);
+    rex::ui::switch_saltynx::Latir(size >> 16, size & 0xffff);
+  }
+}
+void RexSwitchPerfAdd(unsigned, uint64_t) {}
+void RexSwitchPerfMax(unsigned, uint64_t) {}
+bool RexSwitchPerfSkip(unsigned) { return false; }
+void RexSwitchPerfSetThreadName(uint32_t, const char*) {}
+}
