+bool VulkanRenderTargetCache::TryForwardResolve(const draw_util::ResolveInfo& resolve_info,
+                                                VulkanTextureCache& texture_cache) {
+  // Every resolve used to become three GPU passes: dump the render target into
+  // the EDRAM buffer, convert that into the tiled guest layout in shared
+  // memory, then untile it again when the texture reading it is reloaded. In
+  // Free Skate each destination is read by exactly one texture of the same
+  // format, so when the conversion is a plain 8888 copy the pixels can go
+  // straight from the render target into that texture.
+  if (GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled() ||
+      resolve_info.IsCopyingDepth()) {
+    return false;
+  }
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  const draw_util::ResolveCopyDestCoordinateInfo dest_coordinates =
+      resolve_info.copy_dest_coordinate_info;
+  if (dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 ||
+      dest_info.copy_dest_exp_bias != 0 || dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_number) != 0 ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian::k16in32) ||
+      dest_coordinates.offset_x_div_8 || dest_coordinates.offset_y_div_8) {
+    return false;
+  }
+  const draw_util::ResolveEdramInfo edram = resolve_info.color_edram_info;
+  if (edram.format_is_64bpp ||
+      xenos::ColorRenderTargetFormat(edram.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      edram.msaa_samples >= xenos::MsaaSamples::k4X) {
+    return false;
+  }
+  // Which host samples to read: 0 = guest sample 0, 1 = guest sample 1,
+  // 2 = the average of both.
+  uint32_t sample_mode = 0;
+  if (edram.msaa_samples == xenos::MsaaSamples::k2X) {
+    switch (dest_coordinates.copy_sample_select) {
+      case xenos::CopySampleSelect::k0:
+        sample_mode = 0;
+        break;
+      case xenos::CopySampleSelect::k1:
+        sample_mode = 1;
+        break;
+      case xenos::CopySampleSelect::k01:
+        sample_mode = 2;
+        break;
+      default:
+        return false;
+    }
+  }
+
+  // The one render target that owns the resolved EDRAM region.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.empty()) {
+    return false;
+  }
+  auto* source_rt = static_cast<VulkanRenderTarget*>(dump_rectangles_.front().render_target);
+  for (const ResolveCopyDumpRectangle& rectangle : dump_rectangles_) {
+    if (rectangle.render_target != source_rt) {
+      return false;
+    }
+  }
+  const RenderTargetKey rt_key = source_rt->key();
+  if (rt_key.is_depth || rt_key.Is64bpp() ||
+      rt_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      rt_key.msaa_samples != edram.msaa_samples || rt_key.GetPitchTiles() != edram.pitch_tiles) {
+    return false;
+  }
+  // The resolve rectangle's origin in the render target, in pixels.
+  const uint32_t tile_width = xenos::kEdramTileWidthSamples;
+  const uint32_t tile_height =
+      xenos::kEdramTileHeightSamples >> uint32_t(edram.msaa_samples >= xenos::MsaaSamples::k2X);
+  const uint32_t tiles_from_rt_base =
+      (edram.base_tiles + xenos::kEdramTileCount - rt_key.base_tiles) &
+      (xenos::kEdramTileCount - 1);
+  const uint32_t origin_x = (tiles_from_rt_base % edram.pitch_tiles) * tile_width +
+                            resolve_info.coordinate_info.edram_offset_x_div_8 * 8;
+  const uint32_t origin_y = (tiles_from_rt_base / edram.pitch_tiles) * tile_height +
+                            resolve_info.coordinate_info.edram_offset_y_div_8 * 8;
+  const uint32_t resolve_width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t resolve_height = resolve_info.height_div_8 * 8;
+  if (origin_x + resolve_width > rt_key.GetWidth() ||
+      origin_y + resolve_height >
+          GetRenderTargetHeight(rt_key.pitch_tiles_at_32bpp, rt_key.msaa_samples) ||
+      origin_x >= (1u << 13) || origin_y >= (1u << 13)) {
+    return false;
+  }
+
+  const VkPipeline pipeline =
+      GetResolveForwardPipeline(edram.msaa_samples != xenos::MsaaSamples::k1X);
+  if (pipeline == VK_NULL_HANDLE) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (resolve_forward_buffer_ == VK_NULL_HANDLE &&
+      !ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, kResolveForwardBufferSize,
+          VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+          ui::vulkan::util::MemoryPurpose::kDeviceLocal, resolve_forward_buffer_,
+          resolve_forward_buffer_memory_)) {
+    resolve_forward_buffer_ = VK_NULL_HANDLE;
+    return false;
+  }
+
+  uint32_t width = 0, height = 0;
+  const VkImage texture_image = texture_cache.BeginResolveForward(
+      resolve_info.copy_dest_base, resolve_width, resolve_height,
+      dest_coordinates.pitch_aligned_div_32 * 32, xenos::TextureFormat::k_8_8_8_8,
+      xenos::Endian(uint32_t(dest_info.copy_dest_endian)), width, height);
+  if (texture_image == VK_NULL_HANDLE) {
+    return false;
+  }
+  if (VkDeviceSize(width) * height * 4 > kResolveForwardBufferSize) {
+    // The texture was already marked up to date; it keeps its old contents
+    // for this frame, which the normal path cannot fix any more either.
+    return true;
+  }
+
+  VkDescriptorSet buffer_descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (buffer_descriptor_set == VK_NULL_HANDLE) {
+    return true;
+  }
+  VkDescriptorBufferInfo buffer_info;
+  buffer_info.buffer = resolve_forward_buffer_;
+  buffer_info.offset = 0;
+  buffer_info.range = VkDeviceSize(width) * height * 4;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = buffer_descriptor_set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+
+  // Render target: read by the compute shader.
+  command_processor_.PushImageMemoryBarrier(
+      source_rt->image(), ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+      source_rt->current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      source_rt->current_access_mask(), VK_ACCESS_SHADER_READ_BIT, source_rt->current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  source_rt->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  // Staging buffer: the previous forward's copy must have read it.
+  if (resolve_forward_buffer_read_pending_) {
+    command_processor_.PushBufferMemoryBarrier(
+        resolve_forward_buffer_, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_ACCESS_SHADER_WRITE_BIT);
+  }
+  command_processor_.SubmitBarriers(true);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         dump_pipeline_layout_color_, kDumpDescriptorSetEdram, 1,
+                                         &buffer_descriptor_set, 0, nullptr);
+  const VkDescriptorSet source_descriptor_set = source_rt->GetDescriptorSetTransferSource();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         dump_pipeline_layout_color_, kDumpDescriptorSetSource, 1,
+                                         &source_descriptor_set, 0, nullptr);
+  const uint32_t push_constants[2] = {
+      origin_x | (origin_y << 13) | (uint32_t(dest_info.copy_dest_swap) << 26) |
+          (sample_mode << 27),
+      width | (height << 13),
+  };
+  command_buffer.CmdVkPushConstants(dump_pipeline_layout_color_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push_constants), push_constants);
+  command_processor_.GpuOpBegin();
+  command_buffer.CmdVkDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  command_processor_.GpuOpEnd(VulkanCommandProcessor::GpuOp::kResolveCopy);
+
+  command_processor_.PushBufferMemoryBarrier(
+      resolve_forward_buffer_, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.bufferOffset = 0;
+  region.bufferRowLength = width;
+  region.bufferImageHeight = height;
+  region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.mipLevel = 0;
+  region.imageSubresource.baseArrayLayer = 0;
+  region.imageSubresource.layerCount = 1;
+  region.imageExtent = {width, height, 1};
+  command_buffer.CmdVkCopyBufferToImage(resolve_forward_buffer_, texture_image,
+                                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  resolve_forward_buffer_read_pending_ = true;
+#if REX_PLATFORM_SWITCH
+  RexSwitchPerfCount(60);
+#endif
+  return true;
+}
+
+VkPipeline VulkanRenderTargetCache::GetResolveForwardPipeline(bool multisampled) {
+  VkPipeline& pipeline = resolve_forward_pipelines_[multisampled];
+  if (pipeline != VK_NULL_HANDLE) {
+    return pipeline;
+  }
+  SpirvBuilder builder(spv::Spv_1_0, (SpirvShaderTranslator::kSpirvMagicToolId << 16) | 1, nullptr);
+  spv::Id ext_inst_glsl_std_450 = builder.import("GLSL.std.450");
+  builder.addCapability(spv::CapabilityShader);
+  builder.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+  builder.setSource(spv::SourceLanguageUnknown, 0);
+  spv::Id type_void = builder.makeVoidType();
+  spv::Id type_bool = builder.makeBoolType();
+  spv::Id type_int = builder.makeIntType(32);
+  spv::Id type_int2 = builder.makeVectorType(type_int, 2);
+  spv::Id type_uint = builder.makeUintType(32);
+  spv::Id type_uint3 = builder.makeVectorType(type_uint, 3);
+  spv::Id type_float = builder.makeFloatType(32);
+  spv::Id type_float4 = builder.makeVectorType(type_float, 4);
+  std::vector<spv::Id> ids;
+
+  // Set 0: the staging buffer, one packed texel per uint.
+  ids.push_back(builder.makeRuntimeArray(type_uint));
+  builder.addDecoration(ids.back(), spv::DecorationArrayStride, sizeof(uint32_t));
+  spv::Id type_buffer = builder.makeStructType(ids, "XeResolveForwardBuffer");
+  builder.addMemberName(type_buffer, 0, "texels");
+  builder.addMemberDecoration(type_buffer, 0, spv::DecorationNonReadable);
+  builder.addMemberDecoration(type_buffer, 0, spv::DecorationOffset, 0);
+  builder.addDecoration(type_buffer, spv::DecorationBufferBlock);
+  spv::Id buffer =
+      builder.createVariable(spv::NoPrecision, spv::StorageClassUniform, type_buffer, "xe_texels");
+  builder.addDecoration(buffer, spv::DecorationDescriptorSet, kDumpDescriptorSetEdram);
+  builder.addDecoration(buffer, spv::DecorationBinding, 0);
+  // Set 1: the render target.
+  spv::Id source = builder.createVariable(
+      spv::NoPrecision, spv::StorageClassUniformConstant,
+      builder.makeImageType(type_float, spv::Dim2D, false, false, multisampled, 1,
+                            spv::ImageFormatUnknown),
+      "xe_source");
+  builder.addDecoration(source, spv::DecorationDescriptorSet, kDumpDescriptorSetSource);
+  builder.addDecoration(source, spv::DecorationBinding, 0);
+  // Push constants, in the dump layout's two words.
+  ids.clear();
+  ids.push_back(type_uint);
+  ids.push_back(type_uint);
+  spv::Id type_push = builder.makeStructType(ids, "XeResolveForwardConstants");
+  builder.addMemberName(type_push, 0, "origin_flags");
+  builder.addMemberDecoration(type_push, 0, spv::DecorationOffset, 0);
+  builder.addMemberName(type_push, 1, "size");
+  builder.addMemberDecoration(type_push, 1, spv::DecorationOffset, int(sizeof(uint32_t)));
+  builder.addDecoration(type_push, spv::DecorationBlock);
+  spv::Id push = builder.createVariable(spv::NoPrecision, spv::StorageClassPushConstant, type_push,
+                                        "xe_constants");
+  spv::Id input_id = builder.createVariable(spv::NoPrecision, spv::StorageClassInput, type_uint3,
+                                            "gl_GlobalInvocationID");
+  builder.addDecoration(input_id, spv::DecorationBuiltIn, spv::BuiltInGlobalInvocationId);
+
+  std::vector<spv::Id> main_param_types;
+  std::vector<std::vector<spv::Decoration>> main_precisions;
+  spv::Block* main_entry;
+  spv::Function* main_function = builder.makeFunctionEntry(
+      spv::NoPrecision, type_void, "main", main_param_types, main_precisions, &main_entry);
+
+  auto load_push = [&](int member) {
+    std::vector<spv::Id> chain{builder.makeIntConstant(member)};
+    return builder.createLoad(builder.createAccessChain(spv::StorageClassPushConstant, push, chain),
+                              spv::NoPrecision);
+  };
+  auto bits = [&](spv::Id value, uint32_t offset, uint32_t count) {
+    return builder.createTriOp(spv::OpBitFieldUExtract, type_uint, value,
+                               builder.makeUintConstant(offset), builder.makeUintConstant(count));
+  };
+  spv::Id origin_flags = load_push(0);
+  spv::Id size = load_push(1);
+  spv::Id width = bits(size, 0, 13);
+  spv::Id height = bits(size, 13, 13);
+  spv::Id id = builder.createLoad(input_id, spv::NoPrecision);
+  spv::Id x = builder.createCompositeExtract(id, type_uint, 0);
+  spv::Id y = builder.createCompositeExtract(id, type_uint, 1);
+  spv::Id inside = builder.createBinOp(
+      spv::OpLogicalAnd, type_bool, builder.createBinOp(spv::OpULessThan, type_bool, x, width),
+      builder.createBinOp(spv::OpULessThan, type_bool, y, height));
+  SpirvBuilder::IfBuilder inside_if(inside, spv::SelectionControlMaskNone, builder);
+  {
+    ids.clear();
+    ids.push_back(builder.createUnaryOp(
+        spv::OpBitcast, type_int, builder.createBinOp(spv::OpIAdd, type_uint, x,
+                                                      bits(origin_flags, 0, 13))));
+    ids.push_back(builder.createUnaryOp(
+        spv::OpBitcast, type_int, builder.createBinOp(spv::OpIAdd, type_uint, y,
+                                                      bits(origin_flags, 13, 13))));
+    spv::Id coords = builder.createCompositeConstruct(type_int2, ids);
+    spv::Id image = builder.createLoad(source, spv::NoPrecision);
+    auto fetch = [&](uint32_t host_sample) {
+      spv::Builder::TextureParameters parameters = {};
+      parameters.sampler = image;
+      parameters.coords = coords;
+      if (multisampled) {
+        parameters.sample = builder.makeIntConstant(int32_t(host_sample));
+      } else {
+        parameters.lod = builder.makeIntConstant(0);
+      }
+      return builder.createTextureCall(spv::NoPrecision, type_float4, false, true, false, false,
+                                       false, parameters, spv::ImageOperandsMaskNone);
+    };
+    spv::Id color;
+    if (multisampled) {
+      const uint32_t host_sample_0 =
+          draw_util::GetD3D10SampleIndexForGuest2xMSAA(0, msaa_2x_attachments_supported_);
+      const uint32_t host_sample_1 =
+          draw_util::GetD3D10SampleIndexForGuest2xMSAA(1, msaa_2x_attachments_supported_);
+      spv::Id sample_0 = fetch(host_sample_0);
+      spv::Id sample_1 = fetch(host_sample_1);
+      spv::Id mode = bits(origin_flags, 27, 2);
+      ids.clear();
+      spv::Id average = builder.createBinOp(
+          spv::OpVectorTimesScalar, type_float4,
+          builder.createBinOp(spv::OpFAdd, type_float4, sample_0, sample_1),
+          builder.makeFloatConstant(0.5f));
+      color = builder.createTriOp(
+          spv::OpSelect, type_float4,
+          builder.createBinOp(spv::OpIEqual, type_bool, mode, builder.makeUintConstant(2)),
+          average,
+          builder.createTriOp(
+              spv::OpSelect, type_float4,
+              builder.createBinOp(spv::OpIEqual, type_bool, mode, builder.makeUintConstant(1)),
+              sample_1, sample_0));
+    } else {
+      color = fetch(0);
+    }
+    // Red/blue swap requested by the resolve.
+    std::vector<unsigned> swizzle{2, 1, 0, 3};
+    spv::Id swapped = builder.createRvalueSwizzle(spv::NoPrecision, type_float4, color, swizzle);
+    color = builder.createTriOp(
+        spv::OpSelect, type_float4,
+        builder.createBinOp(spv::OpINotEqual, type_bool, bits(origin_flags, 26, 1),
+                            builder.makeUintConstant(0)),
+        swapped, color);
+    spv::Id packed = builder.createUnaryBuiltinCall(type_uint, ext_inst_glsl_std_450,
+                                                    GLSLstd450PackUnorm4x8, color);
+    spv::Id index = builder.createBinOp(spv::OpIAdd, type_uint,
+                                        builder.createBinOp(spv::OpIMul, type_uint, y, width), x);
+    ids.clear();
+    ids.push_back(builder.makeIntConstant(0));
+    ids.push_back(builder.createUnaryOp(spv::OpBitcast, type_int, index));
+    builder.createStore(packed, builder.createAccessChain(spv::StorageClassUniform, buffer, ids));
+  }
+  inside_if.makeEndIf();
+
+  builder.leaveFunction();
+  builder.addExecutionMode(main_function, spv::ExecutionModeLocalSize, 8, 8, 1);
+  spv::Instruction* entry_point =
+      builder.addEntryPoint(spv::ExecutionModelGLCompute, main_function, "main");
+  entry_point->addIdOperand(input_id);
+  std::vector<unsigned int> shader_code;
+  builder.dump(shader_code);
+  pipeline = ui::vulkan::util::CreateComputePipeline(
+      command_processor_.GetVulkanDevice(), dump_pipeline_layout_color_,
+      reinterpret_cast<const uint32_t*>(shader_code.data()), sizeof(uint32_t) * shader_code.size());
+  if (pipeline == VK_NULL_HANDLE) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the resolve forwarding pipeline");
+  }
+  return pipeline;
+}
