@@ -521,6 +521,70 @@ class TextureCache {
   // should be made.
   Texture* FindOrCreateTexture(TextureKey key);
 
+ public:
+  // Resolve forwarding: the texture that is the only one reading a 2D tiled
+  // resolve destination at base_address (no larger than max_width x
+  // max_height, same pitch in texels, format and endianness), or nullptr.
+  Texture* FindResolveForwardTexture(uint32_t base_address, uint32_t max_width,
+                                     uint32_t max_height, uint32_t pitch_texels,
+                                     xenos::TextureFormat format, xenos::Endian endian) const {
+    const uint32_t base_page = (base_address & 0x1FFFFFFF) >> 12;
+    const uint32_t start = base_page << 12;
+    const uint32_t end = start + pitch_texels * max_height * 4;
+    Texture* found = nullptr;
+    uint32_t overlapping = 0;
+    for (const auto& entry : textures_) {
+      const TextureKey& key = entry.first;
+      const uint32_t texture_start = uint32_t(key.base_page) << 12;
+      const uint32_t texture_size = entry.second->GetGuestBaseSize();
+      if (!texture_size || texture_start >= end || start >= texture_start + texture_size) {
+        continue;
+      }
+      ++overlapping;
+      if (key.base_page == base_page && key.dimension == xenos::DataDimension::k2DOrStacked &&
+          key.tiled && !key.packed_mips && key.mip_max_level == 0 &&
+          key.depth_or_array_size_minus_1 == 0 && key.format == format &&
+          key.endianness == endian && !key.signed_separate && !key.scaled_resolve &&
+          uint32_t(key.pitch) * 32 == pitch_texels && key.width_minus_1 < max_width &&
+          key.height_minus_1 < max_height) {
+        found = entry.second.get();
+      }
+    }
+    // Anything else reading this memory would miss the forwarded resolve.
+    return overlapping == 1 ? found : nullptr;
+  }
+  // The texture's guest memory will not receive the forwarded resolve: keep
+  // it from being reloaded from there.
+  void MarkResolveForwardTextureUpToDate(Texture& texture) {
+    texture.MakeUpToDateAndWatch(global_critical_region_.Acquire());
+  }
+
+  // One line per cached texture whose base level overlaps [start, start +
+  // length) of physical memory, describing its key. Diagnostic use: walks
+  // all textures.
+  std::vector<std::string> DescribeTexturesOverlapping(uint32_t start, uint32_t length) const {
+    std::vector<std::string> lines;
+    start &= 0x1FFFFFFF;
+    for (const auto& entry : textures_) {
+      const Texture& texture = *entry.second;
+      const TextureKey key = texture.key();
+      const uint32_t base = uint32_t(key.base_page) << 12;
+      const uint32_t size = texture.GetGuestBaseSize();
+      if (size && base < start + length && start < base + size) {
+        lines.push_back(fmt::format(
+            "base 0x{:08X} {}x{} pitch {} format {} endian {} tiled {} mips {} dim {} "
+            "signed_separate {} scaled {}",
+            base, key.width_minus_1 + 1, key.height_minus_1 + 1, uint32_t(key.pitch),
+            uint32_t(key.format), uint32_t(key.endianness), uint32_t(key.tiled),
+            uint32_t(key.mip_max_level), uint32_t(key.dimension), uint32_t(key.signed_separate),
+            uint32_t(key.scaled_resolve)));
+      }
+    }
+    return lines;
+  }
+
+ protected:
+
   static const LoadShaderInfo& GetLoadShaderInfo(LoadShaderIndex load_shader_index) {
     assert_true(load_shader_index < kLoadShaderCount);
     return load_shader_info_[load_shader_index];
