+void __wrap_svcSleepThread(s64 nano) {
+  const u64 desde = armGetSystemTick();
+  __real_svcSleepThread(nano);
+  Anotar(nano == 0 ? kSleep0 : nano < 0 ? kSleepCeder : nano <= 1000000 ? kSleepCorto : kSleepLargo, desde);
+}
