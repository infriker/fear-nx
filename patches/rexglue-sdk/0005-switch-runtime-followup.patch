+    return true;
+  }
+  // The 0xA0000000, 0xC0000000 and 0xE0000000 views; no 0x1000 shift with 4 KB host pages.
+  if (offset >= 0xA0000000ull && offset < 0x100000000ull) {
+    *physical = static_cast<uint32_t>(offset) & 0x1FFFFFFF;
+    return true;
+  }
