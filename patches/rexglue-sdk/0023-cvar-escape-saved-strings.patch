+TEST_CASE("cvar string serialization round-trips paths and escapes", "[cvar]") {
+  rex::cvar::testing::ResetAllForTesting();
+  const std::string expected = "D:\\FearXbox360Recomp\\logs\\test\\new.log\n\t\"quoted\"";
+  REXCVAR_SET(test_string_flag, expected);
+  const auto save_path = std::filesystem::temp_directory_path() / "cvar_escape_roundtrip.toml";
+  for (const auto& serialized : {rex::cvar::SerializeToTOML(),
+                                 rex::cvar::SerializeToTOML("Test")}) {
+    { std::ofstream file(save_path); file << serialized; }
+    rex::cvar::ResetAllToDefaults();
+    rex::cvar::LoadConfig(save_path);
+    CHECK(REXCVAR_GET(test_string_flag) == expected);
+  }
+  std::filesystem::remove(save_path);
+}
