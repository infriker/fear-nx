+std::string SerializeStringToTOML(const std::string& value) {
+  // Paths and arbitrary strings must survive SaveConfig -> LoadConfig.
+  // In particular, a Windows backslash is not a literal TOML basic-string
+  // character, and can either invalidate the whole file or become an escape.
+  std::ostringstream output;
+  const toml::value<std::string> node(value);
+  output << toml::toml_formatter(node, toml::format_flags::none);
+  return output.str();
+}
