+  // guest threads contend for it. A write racing the read is caught next check.
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    if (!((system_page_flags_valid_[page >> 6] >> (page & 63)) & 1)) {
+      continue;  // invalid pages are uploaded, and hashed, anyway
+    }
+    const uint32_t interval = uint32_t(1) << std::min<uint32_t>(page_stable_[page], 5);
+    if (frame_epoch_ - page_checked_epoch_[page] < interval) {
+      continue;
+    }
+    page_checked_epoch_[page] = frame_epoch_;
+    const uint64_t hash =
+        XXH3_64bits(memory().TranslatePhysical(page << page_size_log2_), page_bytes);
+    if (hash == page_hash_[page]) {
+      if (page_stable_[page] < 5) {
+        ++page_stable_[page];
+      }
+      continue;
+    }
+    page_hash_[page] = hash;
+    page_stable_[page] = 0;
+    hash_changed_pages_.push_back(page);
