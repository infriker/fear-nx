# Build private copies of translated functions. Keep startup tables and all
# overridable public entries outside LTO and outside GCC's profile counters.
find_program(FEAR_PYTHON NAMES python3 REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(FEAR_CPU_WORK_DIR "${CMAKE_CURRENT_BINARY_DIR}/cpu" CACHE PATH "Directory for adapted guest sources")
set(FEAR_PGO "off" CACHE STRING "Guest branch profiling: off, generate or use")
set_property(CACHE FEAR_PGO PROPERTY STRINGS off generate use)
set(FEAR_PGO_PROFILE "" CACHE FILEPATH "Switch recording for FEAR_PGO=use")
option(FEAR_LTO "Use LTO for translated gameplay functions" ON)
if(NOT FEAR_PGO MATCHES "^(off|generate|use)$")
    message(FATAL_ERROR "FEAR_PGO must be off, generate or use")
endif()
if(NOT FEAR_PGO STREQUAL "off" AND NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "15.2.0")
    message(FATAL_ERROR "Switch PGO requires devkitA64 GCC 15.2.0")
endif()
set(fear_nro_name "F.E.A.R. NX Vulkan")
set(guest_units "")
set(guest_tables "")
set(profile_files "")
set(adapter "${CMAKE_CURRENT_LIST_DIR}/prepare-guest.py")
# GCC includes the auxiliary object name in the ID of file-local functions.
# Reuse the recorder's name even when building in a different output tree.
set(aux_dir "${FEAR_CPU_WORK_DIR}/train/CMakeFiles/fear_nx_recomp.dir/generated/default")
if(NOT FEAR_PGO STREQUAL "off")
    file(MAKE_DIRECTORY "${aux_dir}")
endif()
set(profile_root "${CMAKE_CURRENT_BINARY_DIR}/profile-data")
string(REGEX REPLACE "^/+" "" aux_relative "${aux_dir}")
set(profile_units_dir "${profile_root}/${aux_relative}")
foreach(original IN LISTS GENERATED_SOURCES)
    get_filename_component(name "${original}" NAME)
    if(NOT name MATCHES "^fear_xbox360_recomp[.][0-9]+[.]cpp$")
        list(APPEND guest_tables "${original}")
        continue()
    endif()
    set(unit "${FEAR_CPU_WORK_DIR}/guest/${name}")
    add_custom_command(OUTPUT "${unit}"
        COMMAND "${FEAR_PYTHON}" "${adapter}" "${original}" "${unit}"
        DEPENDS "${original}" "${adapter}" VERBATIM)
    list(APPEND guest_units "${unit}")
    if(NOT FEAR_PGO STREQUAL "off")
        set_property(SOURCE "${unit}" APPEND PROPERTY COMPILE_OPTIONS -dumpdir "${aux_dir}/")
    endif()
    if(FEAR_PGO STREQUAL "use")
        list(APPEND profile_files "${profile_units_dir}/${name}.gcda")
        set_property(SOURCE "${unit}" APPEND PROPERTY OBJECT_DEPENDS "${profile_units_dir}/${name}.gcda")
    endif()
endforeach()
list(LENGTH guest_units guest_count)
if(NOT guest_count EQUAL 199)
    message(FATAL_ERROR "Expected 199 generated F.E.A.R. guest units, found ${guest_count}")
endif()

set(guest_flags "")
set(guest_link_flags "")
if(FEAR_PGO STREQUAL "generate")
    set(fear_nro_name "F.E.A.R. NX Vulkan (PGO Recorder)")
    list(APPEND guest_flags -g0 -fno-profile-values -fprofile-generate=. -fprofile-update=atomic -fprofile-info-section)
elseif(FEAR_PGO STREQUAL "use")
    if(NOT EXISTS "${FEAR_PGO_PROFILE}")
        message(FATAL_ERROR "Set FEAR_PGO_PROFILE to a completed Switch .pgo recording")
    endif()
    set(importer "${CMAKE_CURRENT_LIST_DIR}/../pgo/import-profile.py")
    add_custom_command(OUTPUT ${profile_files}
        COMMAND "${FEAR_PYTHON}" "${importer}" "${FEAR_PGO_PROFILE}" "${profile_units_dir}"
        DEPENDS "${FEAR_PGO_PROFILE}" "${importer}" VERBATIM)
    add_custom_target(fear_pgo_data DEPENDS ${profile_files})
    set(pgo_flags "-fprofile-use=${profile_root}" -fno-profile-values -fprofile-correction
        -fprofile-partial-training -fprofile-reorder-functions -Wsystem-headers
        -Werror=missing-profile -Werror=coverage-mismatch)
    list(APPEND guest_flags -g0 ${pgo_flags})
    list(APPEND guest_link_flags ${pgo_flags})
endif()
if(FEAR_LTO AND NOT FEAR_PGO STREQUAL "generate")
    list(APPEND guest_flags -flto -fno-fat-lto-objects)
    list(APPEND guest_link_flags -flto=4 -flto-partition=balanced -fno-strict-aliasing
        -ffp-contract=off -fno-tree-slp-vectorize -fno-tree-vectorize)
endif()
